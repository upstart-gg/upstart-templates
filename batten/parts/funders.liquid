<section class="border-t border-base-300 bg-base-100 text-base-content" aria-labelledby="funders-title">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-10 md:py-20">
    <h2 id="funders-title" class="label text-center">With thanks</h2>
    <ul class="mt-8 flex flex-wrap items-start justify-center gap-x-12 gap-y-8 text-center">
      {%- for funder in data.funders %}
      <li>
        {%- if funder.logo %}<img src="{{ funder.logo }}" class="bw mx-auto h-10 w-auto opacity-80">{% else %}<span class="gothic block text-[1.625rem] text-base-content/85">{{ funder.name }}</span>{% endif %}
        {%- if funder.caption != blank %}<span class="mt-1 block text-[0.9375rem] text-base-content/65">{{ funder.caption }}</span>{% endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
