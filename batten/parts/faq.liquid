{%- comment -%} Questions, opened one at a time. Pass `items` (a list with question and answer), `label` and `title`; `columns: true` sets them in two columns. {%- endcomment -%}
<section class="border-t border-base-300 bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-10 px-5 py-20 md:px-10 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="label">{{ label }}</p>
      <h2 class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)]">{{ title }}</h2>
    </div>
    <div class="lg:col-span-8 {% if columns %}grid gap-x-10 md:grid-cols-2{% endif %}">
      {%- for item in items %}
      <details class="group border-b border-base-300 {% if columns %}first:border-t md:[&:nth-child(2)]:border-t{% else %}first:border-t{% endif %}">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[1.25rem] font-medium [&::-webkit-details-marker]:hidden">
          <span>{{ item.question }}</span>
          <span class="gothic mt-0.5 shrink-0 text-[1.75rem] leading-none text-primary group-open:hidden" aria-hidden="true">+</span><span class="gothic mt-0.5 hidden shrink-0 text-[1.75rem] leading-none text-primary group-open:inline" aria-hidden="true">–</span>
        </summary>
        <div class="record-body body-copy pb-6">{{ item.answer }}</div>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>
