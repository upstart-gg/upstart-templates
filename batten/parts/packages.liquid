<section class="bg-base-100 text-base-content" aria-labelledby="packages-title">
  <div class="mx-auto max-w-[84rem] px-5 pb-20 md:px-10 md:pb-24">
    <h2 id="packages-title" class="sr-only">The packages</h2>
    <ul class="divide-y divide-base-300 border-y border-base-300">
      {%- for plan in data.packages %}
      <li class="grid gap-6 py-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-4">
          <h3 class="title text-[clamp(2.75rem,3vw+1.5rem,4.5rem)]">{{ plan.name }}</h3>
          {%- if plan.featured %}<p class="mt-3"><span class="rep-tag">Most asked for</span></p>{% endif %}
        </div>
        <div class="lg:col-span-3">
          <p class="gothic figures text-[3rem] leading-none text-primary">{{ plan.price }}</p>
          <p class="mt-2 text-[1rem] text-base-content/70">{{ plan.period }}</p>
        </div>
        <div class="lg:col-span-5">
          <p class="body-copy">{{ plan.description }}</p>
          <ul class="mt-4 space-y-1.5 text-[1rem]">
            {%- for feature in plan.features %}<li class="flex gap-3"><span class="text-primary" aria-hidden="true">—</span>{{ feature }}</li>{% endfor %}
          </ul>
          {%- if plan.cta %}<a href="{{ plan.href }}" class="btn {% if plan.featured %}btn-primary{% else %}btn-outline{% endif %} mt-6">{{ plan.cta }}</a>{% endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
