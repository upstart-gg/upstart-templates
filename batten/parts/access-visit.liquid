<section id="access" class="bg-secondary text-secondary-content" aria-labelledby="access-visit-title">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-10 md:py-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label">Access</p>
        <h2 id="access-visit-title" class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)]">Access at the Sash Works</h2>
        <p class="body-copy mt-5">Book an access seat with the box office, by phone or by email: tell us what you need and we'll keep it for you.</p>
        <p class="gothic figures mt-6 text-[2rem]"><a href="tel:+16125550163" class="hover:underline">(612) 555-0163</a></p>
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
        {%- for item in data.access %}
        <li class="border-b border-secondary-content/25 py-4 sm:[&:nth-child(-n+2)]:border-t sm:[&:nth-child(-n+2)]:border-secondary-content/25 first:border-t first:border-secondary-content/25">
          <h3 class="text-[1.5rem]">{{ item.title }}</h3>
          <p class="mt-1 text-[1.0625rem] opacity-85">{{ item.text }}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
    <h3 class="mt-16 border-b-2 border-secondary-content pb-3 text-[clamp(2rem,2vw+1rem,3rem)]">The access performances</h3>
    <ul class="grid gap-x-10 md:grid-cols-2">
      {%- for kind in data["access-performances"] %}
      <li class="flex gap-5 border-b border-secondary-content/25 py-5">
        <span class="gothic h-fit shrink-0 bg-secondary-content px-2 pt-1 pb-0.5 text-[1.25rem] text-secondary">{% case kind.id %}{% when "asl" %}ASL{% when "described" %}AD{% when "captioned" %}OC{% when "relaxed" %}RP{% else %}{{ forloop.index }}{% endcase %}</span>
        <div>
          <h4 class="text-[1.5rem]">{{ kind.title }}</h4>
          <p class="mt-1 text-[1.0625rem] opacity-85">{{ kind.text }}</p>
        </div>
      </li>
      {%- endfor %}
    </ul>
    <p class="mt-8"><a href="/season#access" class="text-link">Every play's access performances</a></p>
  </div>
</section>
