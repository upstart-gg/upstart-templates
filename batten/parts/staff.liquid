<section class="bg-base-200 text-base-content" aria-labelledby="staff-title">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-10 md:py-24">
    <p class="label">Who runs it</p>
    <h2 id="staff-title" class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)]">The people behind the rail</h2>
    <ul class="mt-10 divide-y divide-base-300 border-y border-base-300">
      {%- for member in data.company %}{% if member.group == "staff" %}
      <li id="{{ member.id }}" class="grid gap-3 py-7 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-4">
          <h3 class="text-[2rem] leading-none">{{ member.name }}</h3>
          <p class="credit mt-2">{{ member.role }}</p>
        </div>
        <div class="md:col-span-8">
          <p class="body-copy">{{ member.bio }}</p>
          {%- if member.email %}<p class="mt-2"><a href="mailto:{{ member.email }}" class="text-link text-[1rem]">{{ member.email }}</a></p>{% endif %}
        </div>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
