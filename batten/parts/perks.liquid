<section class="bg-base-200 text-base-content" aria-labelledby="perks-title">
  <div class="mx-auto grid max-w-[84rem] gap-12 px-5 py-20 md:px-10 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="label">Subscribers</p>
      <h2 id="perks-title" class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)]">What you get</h2>
    </div>
    <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8" data-reveal="stagger">
      {%- for perk in data["subscriber-perks"] %}
      <li class="border-t-2 border-primary pt-4">
        <h3 class="text-[1.75rem]">{{ perk.title }}</h3>
        <p class="body-copy mt-2">{{ perk.text }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
