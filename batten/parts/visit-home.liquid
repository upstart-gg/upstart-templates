<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-12 px-5 py-20 md:px-10 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-6" data-reveal>
      <p class="label">Visit</p>
      <h2 class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)]">212 Sawmill Row NE</h2>
      <p class="body-copy mt-5">The Sash Works, between the river and the rail yards. The doors and the bar open an hour before every performance.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://www.openstreetmap.org/search?query=212%20Sawmill%20Row%20NE%2C%20Minneapolis" class="btn btn-outline" target="_blank" rel="noopener">Get directions</a>
        <a href="tel:+16125550163" class="btn btn-ghost figures">(612) 555-0163</a>
      </div>
      <p class="mt-10 border-l-4 border-primary pl-5 text-[1.25rem] leading-snug">Every play has an ASL-interpreted, an audio-described and a captioned performance. <a href="/visit#access" class="text-link whitespace-nowrap">Access at the Sash Works</a></p>
    </div>
    <div class="lg:col-span-5 lg:col-start-8" data-reveal>
      <p class="label">The box office</p>
      <dl class="figures mt-4 divide-y divide-base-300 border-y border-base-300">
        {%- for slot in data.hours %}
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-3">
          <dt class="gothic text-[1.25rem]">{{ slot.day }}</dt>
          <dd>{{ slot.hours }}{% if slot.note != blank %}<span class="block text-[1rem] text-base-content/70">{{ slot.note }}</span>{% endif %}</dd>
        </div>
        {%- endfor %}
      </dl>
    </div>
  </div>
</section>
