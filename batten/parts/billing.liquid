<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 text-center md:px-10 md:py-28">
    <p class="label">The company</p>
    <h2 class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)]">Twelve actors, all season</h2>
    <ul class="gothic mx-auto mt-12 flex max-w-5xl flex-wrap justify-center gap-x-[0.9em] gap-y-[0.15em] text-[clamp(1.75rem,2.5vw+1rem,3.25rem)] leading-[1.2]" data-reveal="stagger">
      {%- for member in data.company %}{% if member.group == "ensemble" %}
      <li><a href="/company#{{ member.id }}" class="whitespace-nowrap hover:text-primary">{{ member.name }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
    <a href="/company" class="btn btn-outline mt-12">Meet the company</a>
  </div>
</section>
