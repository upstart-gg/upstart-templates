{%- comment -%} A titled list beside a photo. Pass `items` (title and text), `label`, `title` and `image`. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-12 px-5 py-20 md:px-10 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <p class="label">{{ label }}</p>
      <h2 class="mt-3 text-[clamp(2.5rem,4vw+1rem,4.5rem)]">{{ title }}</h2>
      {%- if image %}<div class="bw mt-8"><img src="{{ image }}" class="aspect-[4/3] w-full object-cover"></div>{% endif %}
    </div>
    <ul class="divide-y divide-base-300 self-start border-y border-base-300 lg:col-span-7" data-reveal="stagger">
      {%- for item in items %}
      <li class="py-6">
        <h3 class="text-[1.875rem]">{{ item.title }}</h3>
        <p class="body-copy mt-2">{{ item.text }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
