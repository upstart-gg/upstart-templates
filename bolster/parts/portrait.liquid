{%- if member.photo -%}<img src="{{ member.photo }}" class="aspect-square w-full object-cover {{ class }}">{%- else -%}{%- assign words = member.name | split: " " -%}<div class="initials-ground flex aspect-square w-full items-center justify-center bg-secondary text-secondary-content {{ class }}" aria-hidden="true"><span class="display initials">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span></div>{%- endif -%}
