<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-32">
    <h2 class="title-section" data-rise>Your first class</h2>
    <ol class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {% for step in data.first-steps %}
      <li class="border-t border-base-content/40 pt-5">
        <span class="display block text-[3rem] leading-none font-[350] text-primary" aria-hidden="true">{{ forloop.index }}</span>
        <h3 class="title-small mt-4">{{ step.title }}</h3>
        <p class="body-copy mt-2">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
