<details class="question border-b border-base-300">
  <summary class="flex items-baseline justify-between gap-6 py-5">
    <h3 class="display text-[1.5rem] leading-[1.15] font-[450]">{{ item.question }}</h3>
    <svg class="question-mark size-6 shrink-0 translate-y-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  </summary>
  <div class="reading body-copy pb-6">{{ item.answer }}</div>
</details>
