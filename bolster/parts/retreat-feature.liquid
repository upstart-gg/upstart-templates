{% assign retreat = data.workshops | where: "kind", "retreat" | first %}
{% if retreat %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-14 md:px-8 md:py-20">
    <article class="grid overflow-hidden rounded-box bg-secondary text-secondary-content lg:grid-cols-12">
      {% if retreat.cover %}<img src="{{ retreat.cover }}" class="aspect-[16/10] h-full w-full object-cover object-[78%_50%] lg:col-span-7">{% endif %}
      <div class="flex flex-col justify-center gap-5 p-6 md:p-10 lg:col-span-5">
        <p class="eyebrow">The retreat</p>
        <h2 class="title-section"><a href="/workshops/{{ retreat.id }}" class="hover:underline hover:decoration-1 hover:underline-offset-8">{{ retreat.title }}</a></h2>
        <p>{{ retreat.summary }}</p>
        <p class="facts">{% render 'event-date', event: retreat %}<br>{{ retreat.places }} · from {{ retreat.price }}</p>
        <p class="flex flex-wrap items-center gap-x-5 gap-y-3"><a href="/workshops/{{ retreat.id }}#place" class="btn btn-primary whitespace-nowrap">Ask for a place</a><a href="/workshops/{{ retreat.id }}" class="text-link font-semibold whitespace-nowrap">The three days</a></p>
      </div>
    </article>
  </div>
</section>
{% endif %}
