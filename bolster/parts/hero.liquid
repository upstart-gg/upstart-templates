<section class="bg-primary text-primary-content">
  <div class="mx-auto grid max-w-[80rem] px-5 pt-10 pb-16 md:px-8 md:pt-14 lg:grid-cols-12 lg:grid-rows-[auto_1fr_2.5rem] lg:gap-x-8 lg:pb-14">
    <div class="lg:col-span-5 lg:col-start-1 lg:row-start-1 lg:pr-4">
      <p class="eyebrow text-secondary">Yoga &amp; Pilates · Downtown Boise</p>
      <h1 class="title-hero mt-4">An hour on a warm floor.</h1>
    </div>
    <div class="mt-6 lg:col-span-4 lg:col-start-1 lg:row-span-2 lg:row-start-2 lg:mt-8 lg:pr-2">
      <p class="max-w-[44ch] text-primary-content/85">Yoga, mat Pilates and reformer classes upstairs in a 1911 lodge hall, its maple floor warmed by the hot water Boise pipes up from under its foothills. Thirty-eight classes a week, from 6:15 in the morning.</p>
      <p class="mt-6"><a href="#today" class="arrow-link text-secondary">See today's classes {% render 'arrow', down: true %}</a></p>
    </div>
    <img src="/media/long-room.webp" class="mt-10 aspect-[4/3] w-full rounded-box object-cover object-[50%_80%] lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:aspect-auto lg:h-full lg:min-h-[38rem]">
    <div class="relative z-10 mx-4 -mt-16 lg:col-span-4 lg:col-start-5 lg:row-span-2 lg:row-start-2 lg:mx-0 lg:mt-0 lg:self-end">
      {% render 'offer-card' %}
    </div>
  </div>
</section>
