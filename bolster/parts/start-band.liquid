{% for offer in data.offer limit: 1 %}
<section class="bg-secondary text-secondary-content">
  <div class="mx-auto flex max-w-[80rem] flex-wrap items-center justify-between gap-x-10 gap-y-6 px-5 py-16 md:px-8 md:py-20">
    <div class="min-w-0"><h2 class="title-section">{{ offer.title }}</h2><p class="mt-3 max-w-[44ch]">{{ offer.summary }}</p></div>
    <p><a href="{{ offer.href }}" class="btn btn-primary whitespace-nowrap">{{ offer.cta }}</a></p>
  </div>
</section>
{% endfor %}
