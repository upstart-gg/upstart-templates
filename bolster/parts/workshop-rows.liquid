{% assign saturdays = data.workshops | where: "kind", "workshop" %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-32">
    <h2 class="title-section" data-rise>Saturdays</h2>
    <ul class="mt-8 divide-y divide-base-300 border-y border-base-300">
      {% for event in saturdays %}
      <li class="grid gap-x-8 gap-y-5 py-8 md:grid-cols-[6rem_minmax(0,1fr)_auto] md:items-center">
        <p class="flex items-baseline gap-2 md:block"><span class="facts md:block">{{ event.date | date: "%B" }}</span><span class="display text-[4rem] leading-[0.9] font-[300]">{{ event.date | date: "%-d" }}</span></p>
        <div class="min-w-0">
          <h3 class="title-small"><a href="/workshops/{{ event.id }}" class="hover:underline hover:decoration-1 hover:underline-offset-4">{{ event.title }}</a></h3>
          <p class="body-copy mt-1.5">{{ event.summary }}</p>
          <p class="facts mt-2">{{ event.time }} · {{ event.teacher }} · {{ event.place }} · {{ event.places }} · {{ event.price }}</p>
        </div>
        <p class="flex flex-wrap items-center gap-x-5 gap-y-3">{% if event.booking %}<a href="{{ event.booking }}" class="btn btn-primary whitespace-nowrap" aria-label="Book in the app: {{ event.title }}">Book in the app</a>{% endif %}<a href="/workshops/{{ event.id }}" class="text-link whitespace-nowrap" aria-label="Details: {{ event.title }}">Details</a></p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
