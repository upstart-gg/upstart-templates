{% assign paces = "gentle,steady,strong" | split: "," %}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <h2 class="title-section" data-rise>By pace</h2>
    <div class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-3">
      {% for pace in paces %}{% assign held = data.classes | where: "pace", pace %}
      {% if held.size > 0 %}
      <div class="border-t border-base-content/40 pt-5">
        <h3 class="title-small">{% render 'pace-name', pace: pace %}</h3>
        <ul class="mt-4 space-y-2">
          {% for class in held %}<li><a href="/classes/{{ class.id }}" class="text-link">{{ class.name }}</a></li>{% endfor %}
        </ul>
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
