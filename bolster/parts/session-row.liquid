<div data-mat="row" data-tone="{{ session.tone }}">
  <p class="row-time">{% render 'time', start: session.start %}{% if show_day %}<span class="facts block">{% render 'day-name', day: session.weekday %}</span>{% endif %}</p>
  <div class="flex min-w-0 flex-col-reverse md:grid md:grid-cols-[4.5rem_minmax(0,1fr)_7rem] md:items-center md:gap-x-4">
    <p class="facts">{{ session.length }} min<span class="md:hidden"> · {{ session.teacher }}</span></p>
    <p class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-0.5"><a href="/classes/{{ session.class_id }}" class="row-name hover:underline hover:decoration-1 hover:underline-offset-4">{{ session.class }}</a>{% if session.kind == "reformer" %}<span class="counts-mark">counts as two</span>{% endif %}{% if session.note %}<span class="facts">{{ session.note }}</span>{% endif %}</p>
    <p class="facts hidden md:block">{{ session.teacher }}</p>
  </div>
  <a href="{{ session.book | default: book }}" class="row-book" aria-label="Book {{ session.class }}, {{ session.start }}">Book</a>
</div>
