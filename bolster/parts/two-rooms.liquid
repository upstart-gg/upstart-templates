<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-32">
    <h2 class="title-section" data-rise>Two rooms</h2>
    <ul class="mt-8 divide-y divide-base-300 border-y border-base-300">
      {% for room in data.rooms limit: 2 %}
      <li class="grid gap-x-10 gap-y-2 py-6 md:grid-cols-12 md:items-baseline">
        <h3 class="title-small md:col-span-4">{{ room.name }}</h3>
        <p class="body-copy md:col-span-8">{{ room.booking }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
