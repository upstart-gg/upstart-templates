<section class="bg-secondary text-secondary-content">
  <div class="mx-auto grid max-w-[80rem] gap-x-14 gap-y-10 px-5 py-20 md:px-8 md:py-32 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="title-section">The front desk</h2>
      <p class="mt-5 max-w-[36ch]">Open from fifteen minutes before the first class to the end of the last.</p>
      <address class="mt-8 leading-relaxed not-italic">418 Larkin Lane, second floor<br>Boise, Idaho 83702</address>
      <p class="mt-3"><a href="tel:+12085550163" class="text-link whitespace-nowrap">(208) 555-0163</a></p>
      <p class="mt-1"><a href="https://www.openstreetmap.org/search?query=418%20Larkin%20Lane%2C%20Boise%2C%20ID%2083702" class="text-link" rel="noopener" target="_blank">Get directions</a></p>
    </div>
    <dl class="divide-y divide-secondary-content/20 border-y border-secondary-content/20 lg:col-span-7">
      {% for day in data.hours %}
      <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-4 py-3"><dt class="font-semibold">{{ day.day }}</dt><dd><span class="block">{{ day.hours }}</span>{% if day.note %}<span class="facts block">{{ day.note }}</span>{% endif %}</dd></div>
      {% endfor %}
    </dl>
  </div>
</section>
