<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-32">
    <h2 class="title-section" data-rise>Questions</h2>
    <ol class="mt-12 grid gap-x-14 gap-y-12 md:grid-cols-2">
      {% for item in items %}
      <li class="flex gap-5">
        <span class="display w-9 shrink-0 text-[3rem] leading-[0.85] font-[350] text-primary" aria-hidden="true">{{ forloop.index }}</span>
        <div class="min-w-0"><h3 class="display text-[1.5rem] leading-[1.15] font-[450]">{{ item.question }}</h3><div class="reading body-copy mt-2">{{ item.answer }}</div></div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
