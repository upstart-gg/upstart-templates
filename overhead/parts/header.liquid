{% assign here = page.url | split: "/" %}{% capture section %}/{{ here[1] }}{% endcapture %}
<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 text-base-content">
  <div class="mx-auto flex h-[4.5rem] max-w-[84rem] items-center justify-between gap-6 px-5 md:px-8">
    {% render 'logo' %}
    <nav aria-label="Main" class="hidden min-[76rem]:block">
      <ul class="flex items-center whitespace-nowrap">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}{% assign there = item.href | split: "#" | first | split: "?" | first | split: "/" %}{% capture target %}/{{ there[1] }}{% endcapture %}
        <li><a href="{{ item.href }}" class="nav-link" {% if target == section %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="flex shrink-0 items-center gap-2">
      <a href="/visit#visit" class="btn btn-primary hidden whitespace-nowrap sm:inline-flex">Come for a day</a>
      <details class="site-menu min-[76rem]:hidden">
        <summary class="btn btn-ghost relative z-[60] px-3">
          <span class="menu-open inline-flex items-center gap-2"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>Menu</span><span class="menu-close">Close</span>
        </summary>
        <nav aria-label="Menu" class="fixed inset-0 z-50 flex h-dvh flex-col justify-between overflow-y-auto bg-base-100 px-5 pt-28 pb-10 text-base-content md:px-8">
          <ul>
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}{% assign there = item.href | split: "#" | first | split: "?" | first | split: "/" %}{% capture target %}/{{ there[1] }}{% endcapture %}
            <li class="border-b border-base-300"><a href="{{ item.href }}" class="heading block py-3 text-[1.875rem] leading-tight aria-[current=page]:underline aria-[current=page]:decoration-primary aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8" {% if target == section %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
          <div class="mt-12 flex flex-col gap-4">
            <a href="/visit#visit" class="btn btn-primary btn-lg">Come for a day</a>
            <p class="mono text-[0.875rem]">61 Tailrace Street NW, 4th floor</p>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
