<section id="visit" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] items-start gap-10 px-5 pb-20 md:px-8 md:pb-28 lg:grid-cols-12">
    <form data-prefill hx-post="/_data/visits" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#visit-problems swap:innerHTML" class="flex flex-col gap-9 lg:col-span-8">
      <fieldset>
        <legend class="form-part">What for</legend>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <label class="choice"><input type="radio" name="for" value="a tour" data-id="tour" class="radio" required><span>A tour</span></label>
          <label class="choice"><input type="radio" name="for" value="a day pass" data-id="day-pass" class="radio" required><span>A day pass, for a few of us</span></label>
          <label class="choice"><input type="radio" name="for" value="to join a plan" data-id="join" class="radio" required><span>To join a plan</span></label>
          <label class="choice"><input type="radio" name="for" value="an office for a team" data-id="office" class="radio" required><span>An office for a team</span></label>
        </div>
        <fieldset class="fieldset mt-3">
          <legend class="fieldset-legend">The plan you have in mind <span class="font-normal text-base-content/70">(if you do)</span></legend>
          <select name="plan" class="select w-full" aria-label="The plan you have in mind">
            <option value="">Not sure yet</option>
            {%- for plan in data.plans %}
            <option value="{{ plan.name }}" data-id="{{ plan.id }}">{{ plan.name }}</option>
            {%- endfor %}
          </select>
        </fieldset>
      </fieldset>
      <fieldset>
        <legend class="form-part">When</legend>
        <div class="mt-2 grid gap-x-5 sm:grid-cols-3">
          <fieldset class="fieldset"><legend class="fieldset-legend">Day, Monday to Friday</legend><input name="day" type="date" class="input w-full" required aria-label="Day, Monday to Friday"></fieldset>
          <fieldset class="fieldset"><legend class="fieldset-legend">Part of the day</legend><select name="part" class="select w-full" aria-label="Part of the day"><option value="morning">Morning</option><option value="afternoon">Afternoon</option></select></fieldset>
          <fieldset class="fieldset"><legend class="fieldset-legend">How many of you</legend><input name="people" type="number" min="1" max="80" class="input w-full" aria-label="How many of you"></fieldset>
        </div>
      </fieldset>
      <fieldset>
        <legend class="form-part">You</legend>
        <div class="mt-2 grid gap-x-5 sm:grid-cols-2">
          <fieldset class="fieldset"><legend class="fieldset-legend">Name</legend><input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name" aria-label="Name"></fieldset>
          <fieldset class="fieldset"><legend class="fieldset-legend">Email</legend><input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email" aria-label="Email"></fieldset>
          <fieldset class="fieldset sm:col-span-2"><legend class="fieldset-legend">Phone <span class="font-normal text-base-content/70">(if you like)</span></legend><input name="phone" type="tel" class="input w-full" maxlength="30" autocomplete="tel" aria-label="Phone"></fieldset>
          <fieldset class="fieldset sm:col-span-2"><legend class="fieldset-legend">Anything we should know <span class="font-normal text-base-content/70">(if you like)</span></legend><textarea name="note" rows="3" class="textarea w-full" maxlength="2000" aria-label="Anything we should know"></textarea></fieldset>
        </div>
      </fieldset>
      <div id="visit-problems" class="empty:hidden"></div>
      <button class="btn btn-primary btn-lg self-start">Send</button>
    </form>
    <aside class="rounded-box bg-base-200 p-7 md:p-9 lg:sticky lg:top-28 lg:col-span-4">
      <p class="figures text-[2.25rem] leading-none font-medium">Day pass $25</p>
      <p class="mono mt-3 text-[0.875rem] leading-relaxed">8 am to 6 pm, Monday to Friday<br>Members any hour, with their fob</p>
      <p class="mono mt-5 border-t border-base-content/30 pt-5 text-[0.875rem] leading-relaxed"><span class="font-semibold">61 Tailrace Street NW</span><br>River door, step-free, elevator to&nbsp;4</p>
      <p class="mono mt-5 border-t border-base-content/30 pt-5 text-[0.875rem] leading-relaxed">Laker Line, Pew Campus stop, 4&nbsp;minutes'&nbsp;walk<br>Bike room inside the door</p>
    </aside>
  </div>
</section>
