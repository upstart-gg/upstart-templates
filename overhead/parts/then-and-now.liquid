<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-28">
    <h2 class="title-section">The floor, then and now</h2>
    <div class="mt-10 grid gap-x-12 gap-y-12 lg:grid-cols-2">
      <figure>
        {% render 'plan', uid: 'then', then: true %}
        <figcaption class="mono mt-5 text-[0.8125rem] leading-relaxed text-base-content/80">The 1920s: one open hall, twelve columns, and whatever the season was.</figcaption>
      </figure>
      <figure>
        {% render 'plan', uid: 'now', still: true %}
        <figcaption class="mono mt-5 text-[0.8125rem] leading-relaxed text-base-content/80">Today: twenty-eight hot desks, twelve fixed ones, six offices, two meeting rooms, four booths and a kitchen, between the same columns.</figcaption>
      </figure>
    </div>
  </div>
</section>
