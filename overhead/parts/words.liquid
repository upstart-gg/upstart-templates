<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-28">
    <h2 class="sr-only">Members' words</h2>
    <ul class="grid gap-x-14 gap-y-14 lg:grid-cols-12" data-reveal="stagger">
      {%- for word in data.testimonials %}
      <li class="{% if forloop.first %}lg:col-span-12 lg:max-w-[60rem]{% else %}border-t border-base-300 pt-8 lg:col-span-6{% endif %}">
        <blockquote class="quote {% if forloop.first %}text-[clamp(1.625rem,1.6vw+1.1rem,2.5rem)] leading-[1.22]{% else %}text-[1.5rem] leading-[1.3]{% endif %}">“{{ word.quote }}”</blockquote>
        <p class="mt-5"><span class="font-semibold">{{ word.name }}</span>{% if word.role %}, <span class="text-base-content/80">{{ word.role }}</span>{% endif %}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
