<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-28">
    <h2 class="title-section">Two rooms by the hour, for anyone</h2>
    <ul class="mt-10 border-t border-base-content" data-reveal="stagger">
      {%- for zone in data.zones %}{% if zone.kind == "meeting room" %}
      <li class="grid gap-x-10 gap-y-6 border-b border-base-300 py-9 md:grid-cols-12 md:items-center">
        <div class="max-w-[22rem] md:col-span-4">{% render 'plan', uid: zone.id, only: zone.id %}</div>
        <div class="md:col-span-4">
          <h3 class="title-small">{{ zone.name }}</h3>
          {% if zone.summary %}<p class="body-copy mt-2">{{ zone.summary }}</p>{% endif %}
          <p class="mono mt-3 text-[0.875rem]">{{ zone.seats }} seats · {{ zone.equipment | join: ", " | downcase }}</p>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-5 md:col-span-4">
          <dl class="rates">
            {% if zone.hour %}<div><dt>An hour</dt><dd>{{ zone.hour }}</dd></div>{% endif %}
            {% if zone.half_day %}<div><dt>A half day</dt><dd>{{ zone.half_day }}</dd></div>{% endif %}
            {% if zone.day_rate %}<div><dt>A day</dt><dd>{{ zone.day_rate }}</dd></div>{% endif %}
          </dl>
          <a href="/rooms?room={{ zone.id }}#ask" class="btn btn-outline whitespace-nowrap">Ask for this room</a>
        </div>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
