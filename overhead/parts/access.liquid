<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-20 md:px-8 md:pb-28">
    <h2 class="title-section">Access</h2>
    <ul class="mt-8 grid gap-x-10 gap-y-2 border-t border-base-content md:grid-cols-3">
      {%- for note in data.access-notes %}
      <li class="py-6">
        <h3 class="title-small">{{ note.title }}</h3>
        <p class="body-copy mt-2">{{ note.text }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
