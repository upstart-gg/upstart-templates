<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-x-14 gap-y-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-5">
        <h2 class="title-section">Getting here</h2>
        <address class="mt-6 text-[1.1875rem] not-italic">61 Tailrace Street NW, 4th floor<br>Grand Rapids, MI&nbsp;49504</address>
        <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2"><a href="https://www.openstreetmap.org/search?query=61%20Tailrace%20Street%20NW%2C%20Grand%20Rapids%2C%20MI%2049504" class="text-link" rel="noopener" target="_blank">Get directions</a><a href="tel:+16165550162" class="text-link whitespace-nowrap">(616) 555-0162</a></p>
      </div>
      <figure class="lg:col-span-7">
        <img src="/media/blue-bridge.jpg" class="aspect-[16/9] w-full rounded-box object-cover object-[50%_65%]">
        <figcaption class="mono mt-3 text-[0.8125rem] text-base-content/80">The Blue Bridge, the old railroad bridge, now for walking</figcaption>
      </figure>
    </div>
    <ul class="mt-14 grid gap-x-8 sm:grid-cols-2 xl:grid-cols-4">
      {%- for item in data.getting-here %}
      <li class="border-t border-base-content py-5">
        <h3 class="title-small">{{ item.title }}</h3>
        <p class="body-copy mt-2">{{ item.text }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
