<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-x-14 gap-y-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="title-section">With every plan</h2>
      <img src="/media/kitchen.webp" class="mt-8 hidden aspect-[5/4] w-full rounded-box object-cover object-[45%_70%] lg:block">
    </div>
    <ul class="grid content-start gap-x-12 sm:grid-cols-2 lg:col-span-8">
      {%- for item in data.plans-included %}
      <li class="border-t border-base-300 py-6">
        <h3 class="title-small">{{ item.title }}</h3>
        <p class="body-copy mt-2">{{ item.text }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
