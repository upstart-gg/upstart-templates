{%- comment -%}
The floor from above, an inline SVG in feet drawn from the rooms' numbers (data.zones: x, y, w, h from
the north-west corner), with the labels over it. Landscape, and a quarter turn round on a phone.

`only` (a room's id) draws a small still copy with that room lit; `then: true` draws the empty hall of
the past: the outline, the columns and the core only. `still: true` names the rooms
without their prices, the meeting rooms' furniture or the line at the door.

The building, in feet. Change these for another floor; the rooms are records.
{%- endcomment -%}
{%- assign width = 120 -%}
{%- assign depth = 64 -%}
{%- assign windows = "north east south" -%}
{%- assign columns_x = "21 39 57 75 93 111" | split: " " -%}
{%- assign columns_y = "17 46" | split: " " -%}
{%- comment -%} The core (stairs, elevator, restrooms, the front table) and the corner with the lockers and the mail: x y w h. {%- endcomment -%}
{%- assign core = "0 20 16 24" | split: " " -%}
{%- assign lockers = "0 0 16 17" | split: " " -%}
{%- comment -%} The elevator's door, where everybody comes in. {%- endcomment -%}
{%- assign entrance_x = 16 -%}
{%- assign entrance_y = 32 -%}
{%- assign ways = "wide tall" | split: " " -%}
{%- if only or then -%}{%- assign ways = "wide" | split: " " -%}{%- endif -%}
{%- for way in ways -%}
{%- assign tall = false -%}{%- assign vw = width -%}{%- assign vh = depth -%}{%- assign ex = entrance_x -%}{%- assign ey = entrance_y -%}
{%- if way == "tall" -%}{%- assign tall = true -%}{%- assign vw = depth -%}{%- assign vh = width -%}{%- assign ex = entrance_y -%}{%- assign ey = width | minus: entrance_x -%}{%- endif -%}
<div class="plan plan-{{ way }}{% if ways.size == 1 %} plan-only{% endif %}" aria-hidden="true">
<svg viewBox="0 0 {{ vw }} {{ vh }}" class="block h-auto w-full overflow-visible" focusable="false">
{%- unless then -%}
{%- for zone in data.zones -%}
{%- if tall -%}{%- assign x = zone.y -%}{%- assign y = width | minus: zone.x | minus: zone.w -%}{%- assign w = zone.h -%}{%- assign h = zone.w -%}
{%- else -%}{%- assign x = zone.x -%}{%- assign y = zone.y -%}{%- assign w = zone.w -%}{%- assign h = zone.h -%}{%- endif -%}
{%- capture plans_for -%}{%- for plan in data.plans -%}{%- if plan.zones contains zone.name -%}{{ forloop.index }} {% endif -%}{%- endfor -%}{%- endcapture -%}
{%- assign walled = false -%}{%- if zone.kind == "office" or zone.kind == "meeting room" or zone.kind == "phone booths" -%}{%- assign walled = true -%}{%- endif -%}
<g class="zone{% if only == zone.id %} zone-on{% endif %}" data-zone="{{ zone.id }}" data-plans="{{ plans_for | strip }}" data-box="{{ x }} {{ y }} {{ w }} {{ h }}">
<clipPath id="{{ uid }}-{{ way }}-{{ zone.id }}"><circle cx="{{ x }}" cy="{{ y }}" r="200"/></clipPath>
<rect class="zone-light" x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" clip-path="url(#{{ uid }}-{{ way }}-{{ zone.id }})"/>
{%- if walled %}<rect class="plan-partition" x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}"/>{% endif -%}
{%- unless only -%}
{%- if still and zone.kind == "meeting room" or still and zone.kind == "phone booths" -%}{%- else -%}{%- render 'plan-furniture', zone: zone, x: x, y: y, w: w, h: h -%}{%- endif -%}
{%- if zone.kind == "office" or zone.kind == "meeting room" -%}
{%- comment -%} The door, on the inner side of a room along an outer wall, else on its north side. {%- endcomment -%}
{%- assign far_x = zone.x | plus: zone.w -%}{%- assign far_y = zone.y | plus: zone.h -%}
{%- assign side = "north" -%}{%- if far_y >= depth -%}{%- assign side = "north" -%}{%- elsif zone.y == 0 -%}{%- assign side = "south" -%}{%- elsif far_x >= width -%}{%- assign side = "west" -%}{%- elsif zone.x == 0 -%}{%- assign side = "east" -%}{%- endif -%}
{%- assign open = false -%}{%- if zone.state == "free" or zone.state == "free from" -%}{%- assign open = true -%}{%- endif -%}
<g{% if tall %} transform="translate(0 {{ width }}) rotate(-90)"{% endif %}>
{%- if side == "north" -%}{%- assign dx = zone.x | plus: 2 -%}{%- assign dy = zone.y -%}{%- assign turn = 0 -%}
{%- elsif side == "south" -%}{%- assign dx = zone.x | plus: zone.w | minus: 2 -%}{%- assign dy = far_y -%}{%- assign turn = 180 -%}
{%- elsif side == "east" -%}{%- assign dx = far_x -%}{%- assign dy = zone.y | plus: 2 -%}{%- assign turn = 90 -%}
{%- else -%}{%- assign dx = zone.x -%}{%- assign dy = far_y | minus: 2 -%}{%- assign turn = 270 -%}{%- endif -%}
<g transform="translate({{ dx }} {{ dy }}) rotate({{ turn }})"><path class="plan-gap" d="M0 0h3"/>{% if open %}<path class="plan-door" d="M0 0v-3"/><path class="plan-swing" d="M0 -3a3 3 0 0 1 3 3"/>{% else %}<path class="plan-door" d="M0 0h3"/>{% endif %}</g>
</g>
{%- endif -%}
{%- endunless -%}
<rect class="zone-hit" x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}"/>
</g>
{%- endfor -%}
{%- endunless -%}
<g{% if tall %} transform="translate(0 {{ width }}) rotate(-90)"{% endif %}>
{%- for cx in columns_x -%}{%- for cy in columns_y -%}<circle class="plan-column" cx="{{ cx }}" cy="{{ cy }}" r="0.7"/>{%- endfor -%}{%- endfor -%}
{%- assign kx = core[0] | plus: 0 -%}{%- assign ky = core[1] | plus: 0 -%}{%- assign kw = core[2] | plus: 0 -%}{%- assign kh = core[3] | plus: 0 -%}
{%- assign mid = kx | plus: 8 -%}
<rect class="plan-core" x="{{ kx }}" y="{{ ky }}" width="8" height="{{ kh }}"/>
{%- comment -%} The stairs, the restrooms, the elevator with its cross, the front table beside it. {%- endcomment -%}
<path class="plan-partition" d="{% for i in (1..8) %}M{{ kx }} {{ i | times: 1.4 | plus: ky }}h8{% endfor %}M{{ kx }} {{ ky | plus: 12 }}h8M{{ kx }} {{ ky | plus: 18 }}h8M{{ kx | plus: 4 }} {{ ky }}v11.2"/>
<rect class="plan-core" x="{{ mid }}" y="{{ ky | plus: 8 }}" width="{{ kw | minus: 8 }}" height="8"/>
<path class="plan-furniture" d="M{{ mid }} {{ ky | plus: 8 }}l{{ kw | minus: 8 }} 8m0 -8l-{{ kw | minus: 8 }} 8"/>
{%- unless only or then -%}
<path class="plan-furniture" d="M{{ kx | plus: 10 }} {{ ky | plus: 18.5 }}h4.5v3.4h-4.5z"/><circle class="plan-furniture" cx="{{ kx | plus: 9.2 }}" cy="{{ ky | plus: 20.2 }}" r="0.6"/>
<path class="plan-furniture" d="{% for i in (0..6) %}M{{ i | times: 2 | plus: lockers[0] | plus: 1 }} {{ lockers[1] | plus: lockers[3] | minus: 2 }}h2v2h-2z{% endfor %}"/>
{%- endunless -%}
<path class="plan-wall" d="M0 0h{{ width }}v{{ depth }}h-{{ width }}z"/>
{%- comment -%} The windows: a gap in the wall, crossed by a thin double line. {%- endcomment -%}
{%- capture panes -%}
{%- assign along = width | divided_by: 8 | floor | minus: 1 -%}{%- assign down = depth | divided_by: 8 | floor | minus: 1 -%}
{%- for i in (0..along) -%}{%- assign at = i | times: 8 | plus: 1.5 -%}{%- if windows contains "north" -%}M{{ at }} 0h5{%- endif -%}{%- if windows contains "south" -%}M{{ at }} {{ depth }}h5{%- endif -%}{%- endfor -%}
{%- for i in (0..down) -%}{%- assign at = i | times: 8 | plus: 1.5 -%}{%- if windows contains "east" -%}M{{ width }} {{ at }}v5{%- endif -%}{%- if windows contains "west" -%}M0 {{ at }}v5{%- endif -%}{%- endfor -%}
{%- endcapture -%}
<path class="plan-window-gap" d="{{ panes }}"/><path class="plan-window" d="{{ panes }}"/>
{%- unless then -%}<path class="plan-gap" d="M{{ entrance_x }} {{ entrance_y | minus: 2 }}v4"/>{%- endunless -%}
</g>
{%- unless only or then -%}<circle class="plan-entrance" data-entrance cx="{{ ex }}" cy="{{ ey }}" r="1.1"/>{%- endunless -%}
</svg>
{%- unless only or then -%}
<div class="plan-labels">
{%- for zone in data.zones -%}
{%- if tall -%}{%- assign x = zone.y -%}{%- assign y = width | minus: zone.x | minus: zone.w -%}{%- assign w = zone.h -%}{%- assign h = zone.w -%}
{%- else -%}{%- assign x = zone.x -%}{%- assign y = zone.y -%}{%- assign w = zone.w -%}{%- assign h = zone.h -%}{%- endif -%}
{%- assign foot = y | plus: h -%}
<p class="plan-label{% if w < 18 %} plan-label-narrow{% endif %}{% if h < 10 %} plan-label-low{% endif %}" style="left: {{ x | times: 100.0 | divided_by: vw }}%; width: {{ w | times: 100.0 | divided_by: vw }}%; {% if zone.kind == "fixed desks" %}bottom: {{ vh | minus: foot | times: 100.0 | divided_by: vh }}%{% else %}top: {{ y | times: 100.0 | divided_by: vh }}%{% endif %}"><span class="plan-label-name">{{ zone.name }}</span>{% if zone.price and still != true %}<span class="plan-label-price">{{ zone.price }}</span>{% endif %}</p>
{%- endfor -%}
{%- unless still -%}<p class="plan-come-in" style="{% if tall %}left: {{ ex | times: 100.0 | divided_by: vw }}%; top: {{ ey | minus: 1.8 | times: 100.0 | divided_by: vh }}%; translate: -50% -100%; text-align: center{% else %}left: {{ ex | plus: 1.8 | times: 100.0 | divided_by: vw }}%; top: {{ ey | times: 100.0 | divided_by: vh }}%; translate: 0 -50%{% endif %}">You come in here</p>{%- endunless -%}
</div>
{%- endunless -%}
</div>
{%- endfor -%}
