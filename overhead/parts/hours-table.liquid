<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-x-14 gap-y-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <h2 class="title-section lg:col-span-4">The hours</h2>
    <dl class="border-t border-base-content lg:col-span-8">
      {%- for line in data.hours %}
      <div class="grid gap-x-8 gap-y-1 border-b border-base-300 py-5 sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1.3fr)] sm:items-baseline">
        <dt class="font-semibold">{{ line.day }}</dt>
        <dd class="mono text-[0.9375rem]">{{ line.hours }}</dd>
        <dd class="text-base-content/80">{{ line.note }}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
</section>
