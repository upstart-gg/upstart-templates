<section class="bg-base-100 text-base-content">
  <ul class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-28">
    {%- for zone in data.zones %}{% if zone.kind == "meeting room" %}
    <li class="grid gap-x-12 gap-y-8 border-t border-base-content py-10 md:py-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        {% if zone.image %}<img src="{{ zone.image }}" class="aspect-[4/3] w-full rounded-box object-cover md:aspect-[16/10]">{% else %}<div class="aspect-[4/3] w-full rounded-box bg-secondary md:aspect-[16/10]"></div>{% endif %}
      </div>
      <div class="flex flex-col gap-7 lg:col-span-5">
        <div>
          <h2 class="title-section">{{ zone.name }}</h2>
          <p class="mono mt-4 text-[0.875rem]">{{ zone.seats }} seats</p>
          {% if zone.summary %}<p class="body-copy mt-2 max-w-[42ch]">{{ zone.summary }}</p>{% endif %}
          <ul class="ticks mt-4 sm:grid-cols-2">{% for item in zone.equipment %}<li>{{ item }}</li>{% endfor %}</ul>
        </div>
        <div class="grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_13rem]">
          <dl class="rates">
            {% if zone.hour %}<div><dt>An hour</dt><dd>{{ zone.hour }}</dd></div>{% endif %}
            {% if zone.half_day %}<div><dt>A half day</dt><dd>{{ zone.half_day }}</dd></div>{% endif %}
            {% if zone.day_rate %}<div><dt>A day</dt><dd>{{ zone.day_rate }}</dd></div>{% endif %}
          </dl>
          <div class="max-w-[16rem]">{% capture block_uid %}block-{{ zone.id }}{% endcapture %}{% render 'plan', uid: block_uid, only: zone.id %}</div>
        </div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/rooms?room={{ zone.id }}#ask" class="btn btn-primary whitespace-nowrap">Ask for this room</a>
          <p class="text-[0.9375rem]">Members' hours come off first.</p>
        </div>
      </div>
    </li>
    {% endif %}{% endfor %}
  </ul>
</section>
