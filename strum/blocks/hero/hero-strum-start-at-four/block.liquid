<section class="overflow-hidden bg-primary text-primary-content">
  <div class="mx-auto max-w-[80rem] px-5 pt-10 pb-14 md:px-8 md:pt-14 md:pb-20">
    <p class="eyebrow">Music lessons for every age · Nob Hill, Albuquerque</p>
    <h1 class="title-hero mt-4 lg:max-w-[84%]" data-split="words">Start at four.<br>Or at sixty-four.</h1>
    <div class="mt-9 grid items-start gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <ul data-strings data-strings-at="load">
          {% for promise in data.promises %}
          <li>
            {% render 'string' %}
            <div class="strung-row flex items-start gap-4 py-5">
              <span data-tick class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-content text-base-100"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
              <div>
                <p class="text-[1.375rem] leading-snug font-semibold">{{ promise.title }}</p>
                <p class="mt-1">{{ promise.line }}</p>
              </div>
            </div>
            {% if forloop.last %}{% render 'string' %}{% endif %}
          </li>
          {% endfor %}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/start#trial" class="btn btn-neutral btn-lg whitespace-nowrap">Book a free first lesson</a>
          <a href="/programs" class="btn btn-outline btn-lg whitespace-nowrap">Programs by age</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <img src="/media/lesson-hands.jpg" class="aspect-[4/5] w-full rounded-box object-cover object-[50%_45%]">
      </div>
    </div>
  </div>
</section>
