<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-x-14 gap-y-5 lg:grid-cols-12 lg:items-end" data-reveal="stagger">
      <div class="lg:col-span-7">
        <p class="eyebrow text-accent">Programs</p>
        <h2 class="title-section mt-3">Pick an age. We'll find the right start.</h2>
      </div>
      <p class="body-copy max-w-[44ch] lg:col-span-5">We group lessons by age, not by instrument: a five-year-old and a fifty-year-old learn the same violin very differently.</p>
    </div>
    <ul class="mt-12" data-strings>
      {% for program in data.programs %}
      <li>
        {% render 'string', gauge: forloop.index %}
        {% render 'program-row', program: program %}
        {% if forloop.last %}{% render 'string', gauge: forloop.index %}{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
