<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-x-14 gap-y-5 lg:grid-cols-12 lg:items-end" data-reveal="stagger">
      <div class="lg:col-span-7">
        <p class="eyebrow text-accent">Teachers</p>
        <h2 class="title-section mt-3">Who you'd learn from</h2>
      </div>
      <p class="body-copy max-w-[44ch] lg:col-span-5">Working musicians, all of them. Ask for one in the first lesson's form, or let the desk find you a match.</p>
    </div>
    <ul class="mt-12" data-strings>
      {% for member in data.team %}
      <li>
        {% render 'string' %}
        {% render 'teacher-row', member: member, full: true, ask: true %}
        {% if forloop.last %}{% render 'string' %}{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
