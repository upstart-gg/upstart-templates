{%- assign held = data.classes | where: "program", record.id -%}
{%- assign asked = data.program-faq | where: "program", record.id -%}
<!doctype html>
<html lang="en">
<head>
<title>{{ record.name }}, ages {{ record.ages }} — Ristra Music School</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.name }}, ages {{ record.ages }} — Ristra Music School">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header', page: page %}
<main>
<section class="bg-primary text-primary-content">
  <div class="mx-auto max-w-[80rem] px-5 pt-10 pb-28 md:px-8 md:pt-14 md:pb-44">
    <p class="eyebrow"><a href="/programs" class="text-link">Programs by age</a></p>
    <div class="mt-6 grid gap-x-14 gap-y-6 lg:grid-cols-12 lg:items-end">
      <p class="display text-[clamp(5rem,15vw,12.5rem)] leading-[0.9] whitespace-nowrap lg:col-span-7">{{ record.ages_short }}</p>
      <div class="lg:col-span-5">
        <h1 class="title-section">{{ record.name }}</h1>
        <p class="mt-4 max-w-[40ch] text-[1.1875rem] leading-relaxed">{{ record.summary }}</p>
        <p class="mt-6"><a href="/start?program={{ record.id }}#trial" class="btn btn-neutral whitespace-nowrap">Book a free first lesson</a></p>
      </div>
    </div>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto flow-root max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
    {% if record.cover %}<img src="{{ record.cover }}" class="relative -mt-20 aspect-[4/3] w-full rounded-box object-cover object-[50%_35%] md:-mt-32 md:aspect-[21/9]">{% endif %}
    <div class="mt-14 grid gap-x-14 gap-y-12 md:mt-20 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="title-section">What it's like</h2>
        <div class="body-copy reading mt-6 max-w-[60ch]">{{ record.body }}</div>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-box bg-base-200 p-6 md:p-8" data-reveal>
          <h2 class="title-small">First instruments</h2>
          <ul class="mt-5 flex flex-wrap gap-2">
            {% for instrument in record.instruments %}<li class="chip">{{ instrument }}</li>{% endfor %}
          </ul>
          <p class="body-copy mt-5">No instrument at home? <a href="/rentals" class="text-link">Rent one here</a>, from $9 a month.</p>
        </div>
      </div>
    </div>
    {% if held.size > 0 %}
    <h2 class="title-section mt-20 md:mt-28" data-reveal>Classes</h2>
    <ul class="mt-10" data-strings>
      {% for class in held %}
      <li>
        {% render 'string' %}
        <div class="strung-row grid gap-x-8 gap-y-2 py-6 md:grid-cols-[1fr_13rem_14rem]">
          <div class="min-w-0">
            <h3 class="title-small">{{ class.name }}</h3>
            <p class="body-copy mt-1.5 max-w-[46ch]">{{ class.summary }}</p>
            <p class="mt-1.5 text-[0.9375rem]">Ages {{ class.ages }} · {{ class.size }} at most · {{ class.teacher }}</p>
          </div>
          <div>
            <p class="font-semibold">{% render 'day-name', day: class.day %}s</p>
            <p>{{ class.time }}</p>
            <p>{{ class.room }}</p>
          </div>
          <div class="md:text-right">
            <p class="font-medium">{{ class.price }}</p>
            <p class="mt-0.5">{% render 'class-seats', class: class %}</p>
            {% unless class.seats_left == 0 %}<p class="mt-3"><a href="/start?program={{ record.id }}&amp;class={{ class.id }}#enroll" class="inline-flex items-center gap-2 font-semibold whitespace-nowrap">Enroll {% render 'arrow' %}</a></p>{% endunless %}
          </div>
        </div>
        {% if forloop.last %}{% render 'string' %}{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
</section>
<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-x-14 gap-y-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <h2 class="title-section">Private lessons at this age</h2>
      <p class="body-copy mt-5 max-w-[42ch]">{{ record.lesson_note }}</p>
      <p class="mt-7"><a href="/lessons" class="btn btn-outline whitespace-nowrap">Lessons &amp; prices</a></p>
    </div>
    <div class="lg:col-span-7">
      <ul data-strings>
        {% for rate in data.lesson-rates %}{% if rate.programs contains record.id %}
        <li>
          {% render 'string' %}
          <div class="strung-row flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 py-5">
            <h3 class="title-small">{{ rate.name }}</h3>
            <p><span class="text-[1.375rem] font-semibold">{{ rate.price }}</span> {{ rate.period }}</p>
          </div>
        </li>
        {% endif %}{% endfor %}
        <li>{% render 'string' %}</li>
      </ul>
    </div>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pt-20 md:px-8 md:pt-28">
    <h2 class="title-section" data-reveal>Teachers for this age</h2>
    <ul class="mt-10" data-strings>
      {% for member in data.team %}{% if member.programs contains record.id %}
      <li>
        {% render 'string' %}
        {% render 'teacher-row', member: member, ask: true %}
      </li>
      {% endif %}{% endfor %}
      <li>{% render 'string' %}</li>
    </ul>
  </div>
</section>
{% if asked.size > 0 %}{% render 'questions', items: asked, title: "Before you book" %}{% endif %}
<section class="bg-secondary text-secondary-content">
  <div class="mx-auto flex max-w-[80rem] flex-col items-start justify-between gap-8 px-5 py-14 md:px-8 lg:flex-row lg:items-center">
    <div>
      <p class="eyebrow">Another age?</p>
      <ul class="mt-3 flex flex-wrap gap-x-8 gap-y-3">
        {% for program in data.programs %}{% unless program.id == record.id %}
        <li><a href="/programs/{{ program.id }}" class="title-small display inline-flex items-center gap-2 whitespace-nowrap">{{ program.name }} {% render 'arrow' %}</a></li>
        {% endunless %}{% endfor %}
      </ul>
    </div>
    <a href="/start?program={{ record.id }}#trial" class="btn btn-neutral btn-lg shrink-0 whitespace-nowrap">Book a free first lesson</a>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
