<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
    <div class="space-y-20" data-term data-tz="America/Denver">
      <div class="grid gap-x-14 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="title-section">Fall term</h2>
          <p class="mt-3 font-medium">September 7 to December 18<br>13 weeks of lessons</p>
        </div>
        {% assign rows = data.dates | where: "term", "fall-2027" %}
        {% render 'term-rows', rows: rows %}
      </div>
      <div class="grid gap-x-14 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="title-section">Spring term</h2>
          <p class="mt-3 font-medium">January 10 to May 6<br>16 weeks of lessons</p>
        </div>
        {% assign rows = data.dates | where: "term", "spring-2028" %}
        {% render 'term-rows', rows: rows %}
      </div>
      <div class="grid gap-x-14 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="title-section">Summer</h2>
          <p class="mt-3 font-medium">June 5 to July 28<br>Weekday camps</p>
        </div>
        {% assign rows = data.dates | where: "term", "summer-2028" %}
        {% render 'term-rows', rows: rows %}
      </div>
    </div>
  </div>
</section>
