<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <h2 class="title-section" data-reveal>How renting works</h2>
    <ol class="mt-12 grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for step in data.rental-steps %}
      <li class="flex gap-5 sm:block">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary text-[1.1875rem] font-semibold text-primary-content">{{ forloop.index }}</span>
        <div>
          <h3 class="plain-heading text-[1.1875rem] leading-snug font-semibold sm:mt-5">{{ step.title }}</h3>
          <p class="body-copy mt-1.5 max-w-[32ch]">{{ step.text }}</p>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
