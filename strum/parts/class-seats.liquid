{%- if class.seats_left == 0 %}<a href="/start?program={{ class.program }}&amp;class={{ class.id }}#enroll" class="font-medium whitespace-nowrap text-accent">Full: ask for the waitlist</a>{% elsif class.seats_left == 1 %}<span class="font-medium whitespace-nowrap text-accent">1 seat left</span>{% elsif class.seats_left and class.seats_left < 4 %}<span class="font-medium whitespace-nowrap text-accent">{{ class.seats_left }} seats left</span>{% else %}<span class="whitespace-nowrap">Places open</span>{% endif -%}
