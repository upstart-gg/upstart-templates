<section id="week" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-x-14 gap-y-5 lg:grid-cols-12 lg:items-end" data-reveal="stagger">
      <div class="lg:col-span-7">
        <p class="eyebrow text-accent">Group classes &amp; ensembles</p>
        <h2 class="title-section mt-3">The week's classes</h2>
      </div>
      <p class="body-copy max-w-[44ch] lg:col-span-5">One level per group, a fixed evening, the number of the room on the door. Ensembles cost $120 alongside private lessons.</p>
    </div>
    <ul class="mt-12" data-strings>
      {% assign days = "mon,tue,wed,thu,fri,sat" | split: "," %}
      {% for day in days %}
      {% assign held = data.classes | where: "day", day %}
      {% if held.size > 0 %}
      <li>
        {% render 'string', gauge: 3 %}
        <div class="strung-row grid gap-x-8 gap-y-4 py-7 lg:grid-cols-[11rem_1fr]">
          <h3 class="title-small">{% render 'day-name', day: day %}</h3>
          <ul class="space-y-6">
            {% for class in held %}
            <li class="grid gap-x-6 gap-y-1 sm:grid-cols-[9.5rem_1fr] md:grid-cols-[9.5rem_1fr_13rem]">
              <p class="font-semibold">{{ class.time }}</p>
              <div class="min-w-0">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1"><a href="/programs/{{ class.program }}" class="text-link text-[1.1875rem] leading-snug font-semibold">{{ class.name }}</a>{% if class.kind == "ensemble" %}<span class="chip">Ensemble</span>{% endif %}</p>
                <p class="body-copy mt-1 max-w-[46ch]">{{ class.summary }}</p>
                <p class="mt-1 text-[0.9375rem]">Ages {{ class.ages }} · {{ class.room }} · {{ class.teacher }}</p>
              </div>
              <div class="text-[0.9375rem] sm:col-start-2 md:col-start-auto md:text-right">
                <p class="font-medium">{{ class.price }}</p>
                <p class="mt-0.5">{% render 'class-seats', class: class %}</p>
              </div>
            </li>
            {% endfor %}
          </ul>
        </div>
      </li>
      {% endif %}
      {% endfor %}
      <li>{% render 'string', gauge: 3 %}</li>
    </ul>
  </div>
</section>
