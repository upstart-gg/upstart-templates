<section class="bg-primary text-primary-content">
  <div class="mx-auto max-w-[80rem] px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-x-14 gap-y-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="title-section">Your first lesson is on us</h2>
        <p class="mt-8"><a href="/start#trial" class="btn btn-neutral btn-lg whitespace-nowrap">Book a free first lesson</a></p>
      </div>
      <ol class="flex flex-col gap-7 md:flex-row md:gap-4 lg:col-span-7" data-reveal="stagger">
        {% for step in data.first-lesson-steps %}
        <li class="flex flex-1 items-start gap-4">
          <div class="flex-1">
            <span class="flex size-12 items-center justify-center rounded-full bg-primary-content text-[1.1875rem] font-semibold text-base-100">{{ forloop.index }}</span>
            <h3 class="plain-heading mt-4 text-[1.1875rem] leading-snug font-semibold">{{ step.title }}</h3>
            {%- if step.text %}<p class="mt-1">{{ step.text }}</p>{% endif %}
          </div>
          {% unless forloop.last %}<svg class="mt-3 hidden size-6 shrink-0 md:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>{% endunless %}
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
