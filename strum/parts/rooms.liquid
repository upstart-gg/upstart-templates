<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-x-14 gap-y-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow text-accent">Which door</p>
      <h2 class="title-section mt-3">The rooms</h2>
      <img src="/media/adobe-courtyard.jpg" class="mt-10 hidden aspect-[4/5] w-full rounded-box object-cover object-[78%_50%] lg:block">
    </div>
    <ul class="lg:col-span-7" data-strings>
      {% for room in data.rooms %}
      <li>
        {% render 'string' %}
        <div class="strung-row grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[12rem_1fr] sm:items-baseline">
          <h3 class="title-small whitespace-nowrap">{{ room.name }}</h3>
          <p>{{ room.use }}</p>
        </div>
        {% if forloop.last %}{% render 'string' %}{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
