<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
    <ul data-strings>
      {% for program in data.programs %}
      {% assign held = data.classes | where: "program", program.id %}
      <li>
        {% assign gauge = forloop.index | at_most: 4 %}
        {% render 'string', gauge: gauge %}
        {% render 'program-row', program: program, classes: held %}
        {% if forloop.last %}{% render 'string', gauge: gauge %}{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
