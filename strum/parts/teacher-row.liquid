{%- assign words = member.name | split: " " -%}
<div class="strung-row grid grid-cols-[5.5rem_1fr] gap-x-5 gap-y-4 py-6 sm:grid-cols-[8rem_1fr] md:gap-x-8 md:py-7 lg:grid-cols-[9rem_16rem_1fr_auto] lg:items-center">
  {% render 'portrait', member: member, class: 'w-full' %}
  <div class="min-w-0">
    <h3 class="plain-heading text-[1.375rem] leading-snug font-semibold">{{ member.name }}</h3>
    {%- if full and member.pronouns %}<p class="text-[0.9375rem]">{{ member.pronouns }}</p>{% endif %}
    <p class="mt-1 font-medium text-accent">{{ member.instruments }}</p>
    <p class="mt-1 text-[0.9375rem]">{{ member.ages }}</p>
  </div>
  <div class="col-span-2 min-w-0 lg:col-span-1">
    {%- if full %}
    <p class="body-copy max-w-[52ch]">{{ member.bio }}</p>
    <p class="mt-2 max-w-[52ch] text-[0.9375rem] font-medium">{{ member.plays }}</p>
    {%- else %}
    <p class="max-w-[40ch] text-[1.1875rem] leading-snug">{{ member.plays }}</p>
    {%- endif %}
  </div>
  {%- if ask %}
  <a href="/start?teacher={{ member.id }}#trial" class="col-span-2 inline-flex items-center gap-2 font-semibold whitespace-nowrap lg:col-span-1">Ask for {{ words.first }} {% render 'arrow' %}</a>
  {%- endif %}
</div>
