<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-x-14 gap-y-5 lg:grid-cols-12 lg:items-end" data-reveal="stagger">
      <div class="lg:col-span-7">
        <p class="eyebrow text-primary">Recitals &amp; concerts</p>
        <h2 class="title-section mt-3">Come hear them play</h2>
      </div>
      <p class="body-copy max-w-[44ch] lg:col-span-5">Every student who wants to plays twice a year. Every concert is free but one, and that one pays for lessons.</p>
    </div>
    <ul class="mt-12" data-strings data-term data-tz="America/Denver">
      {% for concert in data.concerts limit: 3 %}
      <li data-starts="{{ concert.date }}" data-ends="{{ concert.ends }}">
        {% render 'string' %}
        {% render 'concert-row', concert: concert, date_class: 'text-primary' %}
        {% if forloop.last %}{% render 'string' %}{% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="mt-10"><a href="/concerts" class="btn btn-outline whitespace-nowrap">All recitals &amp; concerts</a></p>
  </div>
</section>
