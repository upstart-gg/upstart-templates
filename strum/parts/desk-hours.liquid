<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-x-14 gap-y-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow text-accent">The front desk</p>
      <h2 class="title-section mt-3">{{ title }}</h2>
      <address class="mt-5 not-italic">16 Oberlin Court SE<br>Albuquerque, NM&nbsp;87106</address>
      <p class="mt-3"><a href="tel:+15055550164" class="text-link whitespace-nowrap">(505) 555-0164</a></p>
      <p class="mt-5"><a href="https://www.openstreetmap.org/search?query=16%20Oberlin%20Court%20SE%2C%20Albuquerque%2C%20NM%2087106" class="btn btn-outline whitespace-nowrap" rel="noopener" target="_blank">Get directions</a></p>
    </div>
    <ul class="lg:col-span-8" data-strings>
      {% for day in data.hours %}
      <li>
        {% render 'string' %}
        <div class="strung-row grid grid-cols-[1fr_auto] gap-x-6 gap-y-0.5 py-4 sm:grid-cols-[9rem_1fr_auto]">
          <p class="font-semibold">{{ day.day }}</p>
          <p class="body-copy order-last col-span-2 sm:order-none sm:col-span-1">{{ day.note }}</p>
          <p class="text-right font-medium">{{ day.hours }}</p>
        </div>
        {% if forloop.last %}{% render 'string' %}{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
