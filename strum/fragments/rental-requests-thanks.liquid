{%- assign rental = data.rentals | where: "name", record.instrument | first -%}
<div class="rounded-box bg-base-100 p-6 md:p-8 lg:col-span-8" role="status">
  <p class="plain-heading text-[1.75rem]">Thank you, {{ record.name }}.</p>
  <p class="mt-3 max-w-[52ch] text-[1.1875rem]">{% if rental.size_options.size > 1 and rental.size_options contains record.size %}A {{ record.size | downcase }} {{ record.instrument | downcase }}{% else %}Your {{ record.instrument | downcase }}{% endif %} will be waiting at the desk. You told us: {{ record.week }}.</p>
  <p class="body-copy mt-3 max-w-[52ch]">{% if rental.size_options.size > 1 %}We'll fit it{% if record.player %} to {{ record.player }}{% endif %} when you come by, and take the first month then.{% else %}We'll take the first month when you come by.{% endif %}</p>
</div>
