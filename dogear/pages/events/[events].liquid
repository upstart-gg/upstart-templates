{%- assign ebook = data.products | where: "name", record.book | first -%}
<!doctype html>
<html lang="en">
<head>
<title>{{ record.title }} — Half Title Books &amp; Coffee</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.title }} — Half Title Books &amp; Coffee">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header', page: page %}
<main>
<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pt-10 pb-20 md:px-8 md:pt-14 md:pb-24">
    <p class="label text-base-content/75"><a href="/events" class="text-link">Readings &amp; events</a></p>
    <div class="mt-8 grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <div class="flex gap-6" data-event data-date="{{ record.date }}" data-starts="{{ record.starts }}" data-tz="America/New_York">
          {% render 'date-block', date: record.date %}
          <div class="min-w-0">
            <p class="flex flex-wrap items-center gap-3"><span data-tag="tonight">Tonight</span><span data-tag="today">Today</span><span class="facts text-base-content/80">{{ record.date | date: "%A, %B %-d" }} · {{ record.time }}</span></p>
            <h1 class="mt-3 text-[clamp(2.25rem,3vw+1rem,3.75rem)] leading-[1.05]">{{ record.title }}</h1>
          </div>
        </div>
        <dl class="facts mt-10 border-t border-base-content/80">
          <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-base-300 py-3"><dt class="label text-base-content/75">Where</dt><dd>{{ record.place }}</dd></div>
          <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-base-300 py-3"><dt class="label text-base-content/75">Price</dt><dd>{{ record.price }}</dd></div>
          {%- if record.author %}<div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-base-300 py-3"><dt class="label text-base-content/75">With</dt><dd>{{ record.author }}</dd></div>{% endif %}
        </dl>
        <div class="body-copy reading-text mt-10 max-w-[62ch] text-[1.125rem]">{{ record.body }}</div>
        <div class="mt-10 flex flex-wrap gap-3">
          {%- if record.booking %}<a href="{{ record.booking }}" class="btn btn-primary btn-lg whitespace-nowrap" rel="noopener" target="_blank">Get tickets</a>
          {%- elsif record.rsvp == "walk-in" %}<p class="font-heading text-[1.375rem] font-medium">Free, no need to RSVP: just come.</p>
          {%- else %}<a href="#rsvp" class="btn btn-primary btn-lg whitespace-nowrap">RSVP</a>{% endif %}
        </div>
      </div>
      <div class="lg:col-span-5">
        {%- if ebook %}
        <div class="flex justify-center rounded-box bg-base-200 px-8 pt-14 pb-12" data-picks>
          <div class="w-[min(100%,16rem)]">{% if ebook.note %}{% render 'pick', book: ebook, talker: 'full' %}{% else %}<a href="/books/{{ ebook.id }}" class="mx-auto block w-[calc(var(--f)*100%)]" data-format="{{ ebook.format }}">{% render 'jacket', book: ebook %}</a>{% endif %}</div>
        </div>
        <p class="mt-4 flex flex-wrap items-center justify-between gap-3"><a href="/books/{{ ebook.id }}" class="text-link font-semibold">About the book</a>{% render 'hold-link', book: ebook, online: false %}</p>
        {%- endif %}
      </div>
    </div>
  </div>
</article>
{%- if record.rsvp != "walk-in" and record.booking == blank %}
{% render 'rsvp-form', chosen: record.id %}
{%- endif %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.5rem)]">Also coming up</h2>
      <a href="/events" class="text-link font-semibold">All events</a>
    </div>
    <ul class="mt-10 grid gap-6 md:grid-cols-2" data-upcoming="2">
      {%- for event in data.events %}{% if event.id != record.id %}
      <li data-event data-date="{{ event.date }}" data-starts="{{ event.starts }}">
        <a href="/events/{{ event.id }}" class="group flex h-full gap-5 rounded-box bg-base-200 p-6">
          {% render 'date-block', date: event.date %}
          <span class="min-w-0"><span class="facts block text-base-content/80">{{ event.time }} · {{ event.place }}</span><span class="mt-1 block font-heading text-[1.25rem] font-semibold leading-snug group-hover:underline group-hover:decoration-primary group-hover:decoration-2 group-hover:underline-offset-4">{{ event.title }}</span><span class="facts mt-2 block">{{ event.price }}</span></span>
        </a>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
