<span class="date-block flex w-[4.5rem] shrink-0 flex-col items-center self-start rounded-box bg-primary px-2 pt-2.5 pb-2 text-primary-content sm:w-[5.25rem]"><span class="[font-family:var(--font-body)] text-[0.75rem] font-semibold tracking-[0.08em] uppercase">{{ date | date: "%a" }}</span><span class="text-[2.25rem] leading-none font-semibold sm:text-[2.75rem]">{{ date | date: "%-d" }}</span><span class="label leading-tight">{{ date | date: "%b" }}</span></span>
