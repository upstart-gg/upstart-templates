<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <p class="label text-base-content/75">The café corner</p>
      <h2 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3rem)]">At the soda counter</h2>
      <p class="body-copy mt-4 max-w-[40ch]">Six stools. Books may come to the counter; please don't dunk them. From 8 am on weekdays.</p>
      <div class="mt-8 grid grid-cols-2 gap-3">
        <img src="/media/cappuccino.jpg" class="aspect-square w-full rounded-box object-cover">
        <img src="/media/sweet-bread.jpg" class="aspect-square w-full rounded-box object-cover">
      </div>
    </div>
    <div class="rounded-box bg-base-200 p-6 md:p-10 lg:col-span-7">
      {% render 'menu-course', course: 'drinks', title: 'Coffee & tea' %}
      {% render 'menu-course', course: 'pastries', title: 'From the bakery', class: 'mt-10' %}
    </div>
  </div>
</section>
