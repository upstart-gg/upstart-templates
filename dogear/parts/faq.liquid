{%- comment -%} Questions as ruled details: pass items, title, and columns: true for two columns. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="label text-base-content/75">Questions</p>
        <h2 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3.25rem)]">{{ title }}</h2>
        <p class="body-copy mt-4 max-w-[34ch]">Anything else, call us at <a href="tel:+14015550163" class="text-link whitespace-nowrap">(401) 555-0163</a>.</p>
      </div>
      <div class="lg:col-span-8 {% if columns %}grid gap-x-10 md:grid-cols-2{% endif %}">
        {%- for item in items %}
        <details class="question border-b border-base-300 {% if forloop.first %}border-t{% elsif columns and forloop.index == 2 %}md:border-t{% endif %}">
          <summary class="flex items-start justify-between gap-6 py-5 font-heading text-[1.25rem] font-semibold leading-snug">{{ item.question }}<span class="question-mark mt-1 text-[1.5rem] leading-none font-normal" aria-hidden="true">+</span></summary>
          <div class="body-copy reading-text max-w-[60ch] pb-6">{{ item.answer }}</div>
        </details>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
