<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="label text-base-content/75">Finding us</p>
      <h2 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3rem)]">A block from the Armory</h2>
      <img src="/media/armory.jpg" class="mt-8 aspect-[4/3] w-full rounded-box object-cover">
    </div>
    <ul class="grid content-start gap-x-8 border-t border-base-content/80 sm:grid-cols-2 lg:col-span-7" data-reveal="stagger">
      {%- for item in data.getting-here %}
      <li class="border-b border-base-300 py-6"><h3 class="text-[1.25rem]">{{ item.title }}</h3>{% if item.text %}<p class="body-copy mt-2">{{ item.text }}</p>{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>
</section>
