<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div data-reveal>
      <p class="label text-base-content/75">{{ label }}</p>
      <h2 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3.25rem)]">{{ title }}</h2>
    </div>
    <ol class="mt-12 grid gap-x-8 gap-y-10 border-t border-base-content/80 pt-8 sm:grid-cols-2 lg:grid-flow-col lg:auto-cols-fr lg:grid-cols-none" data-reveal="stagger">
      {%- for step in items %}
      <li>
        <p class="facts text-[1.75rem] leading-none font-semibold">{{ forloop.index }}</p>
        <h3 class="mt-4 text-[1.25rem]">{{ step.title }}</h3>
        <p class="body-copy mt-2">{{ step.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
