{%- comment -%} One course of the café's menu: pass course (drinks or pastries) and its title. {%- endcomment -%}
<h3 class="label text-[1.25rem] {{ class }}">{{ title }}</h3>
<ul class="mt-3 border-t border-base-content/70">
  {%- for item in data.menu %}{% if item.course == course %}
  <li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-6 border-b border-base-300 py-3">
    <span class="font-heading text-[1.1875rem] font-semibold">{{ item.name }}</span>
    <span class="facts text-[1.125rem]">{{ item.price }}</span>
    {%- if item.description %}<span class="col-span-2 text-[0.9375rem] text-base-content/75">{{ item.description }}</span>{% endif %}
  </li>
  {%- endif %}{% endfor %}
</ul>
