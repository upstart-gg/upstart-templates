<section id="join" class="scroll-mt-24 bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="label text-base-content/75">Sign up</p>
      <h2 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3rem)]">Save me a seat</h2>
      <p class="body-copy mt-4 max-w-[36ch]">We'll write back with the date of the next meeting and keep the book behind the counter for you if you like.</p>
    </div>
    <form hx-post="/_data/club-signups" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#club-signups-problems swap:innerHTML" class="grid gap-x-5 gap-y-1 rounded-box bg-base-100 p-6 sm:grid-cols-2 md:p-8 lg:col-span-8" data-prefill>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend text-[0.9375rem]">The club <span class="required-mark" aria-hidden="true">*</span></legend>
        <select name="club" class="select w-full" required>
          {%- for club in data.clubs %}
          <option value="{{ club.name }}" data-id="{{ club.id }}">{{ club.name }} · {{ club.when }}</option>
          {%- endfor %}
        </select>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-[0.9375rem]">Your name <span class="required-mark" aria-hidden="true">*</span></legend>
        <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-[0.9375rem]">Your email <span class="required-mark" aria-hidden="true">*</span></legend>
        <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-[0.9375rem]">Your phone <span class="font-normal text-base-content/70">(optional)</span></legend>
        <input name="phone" type="tel" class="input w-full" maxlength="30" autocomplete="tel">
      </fieldset>
      <label class="mt-3 flex items-center gap-3 self-end pb-2"><input name="hold_book" type="checkbox" value="true" class="checkbox checkbox-primary" checked><span>Hold the next book for me</span></label>
      <div id="club-signups-problems" class="sm:col-span-2"></div>
      <div class="mt-5 sm:col-span-2"><button class="btn btn-primary btn-lg whitespace-nowrap">Save me a seat</button></div>
    </form>
  </div>
</section>
