<section id="signed" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-24">
    <div class="grid gap-8 border-t border-base-content/80 pt-10 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="label text-accent">Signed copies</p>
        <h2 class="mt-3 text-[clamp(1.75rem,2vw+1rem,2.5rem)]">Signed by the author, here on the shelf</h2>
        <p class="body-copy mt-4 max-w-[36ch]">Signed copies go fast; we hold them for a week.</p>
      </div>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-8">
        {%- for book in data.products %}{% if book.badge == "Signed" %}
        <li class="flex flex-col">
          <div class="flex min-h-[10rem] flex-1 items-end"><a href="/books/{{ book.id }}" class="block w-[calc(var(--f)*7.5rem)]" data-format="{{ book.format }}">{% render 'jacket', book: book %}</a></div>
          <h3 class="mt-4 text-[1.125rem] leading-snug">{{ book.name }}</h3>
          <p class="mt-1 text-[0.9375rem] text-base-content/75">{{ book.author }} · <span class="facts">{{ book.price }}</span></p>
          <div class="mt-3">{% render 'hold-link', book: book, online: false %}</div>
        </li>
        {%- endif %}{% endfor %}
      </ul>
    </div>
  </div>
</section>
