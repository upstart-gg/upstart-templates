{%- assign featured = data.products | where: "featured", true | first -%}
{%- unless featured -%}{%- assign featured = data.products | where: "pick", true | first -%}{%- endunless -%}
<section id="week" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="label text-base-content/75">Book of the week</p>
      <h2 class="mt-3 max-w-[20ch] text-[clamp(2rem,2.5vw+1rem,3.25rem)]">The one we can't stop talking about</h2>
    </div>
    {%- if featured %}
    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="flex justify-center self-start rounded-box bg-base-200 px-8 pt-14 pb-12 lg:col-span-5" data-picks>
        <div class="w-[min(100%,17.5rem)]">{% render 'pick', book: featured, talker: 'full' %}</div>
      </div>
      <div class="lg:col-span-7 lg:pt-4">
        <h3 class="text-[clamp(1.75rem,1.5vw+1.25rem,2.5rem)] font-medium">{{ featured.name }}</h3>
        <p class="mt-2 text-[1.125rem] text-base-content/80">by {{ featured.author }}</p>
        <div class="body-copy mt-6 max-w-[62ch] text-[1.0625rem]">{{ featured.body | split: "</p>" | first }}</p></div>
        <p class="facts mt-8 flex flex-wrap gap-x-5 gap-y-1 border-y border-base-300 py-3 text-base-content/85">{% if featured.publisher %}<span>{{ featured.publisher }}</span>{% endif %}{% if featured.pages %}<span>{{ featured.pages }} pages</span>{% endif %}<span>{{ featured.price }}</span>{% if featured.badge == "Signed" %}<span class="text-accent">Signed copy</span>{% endif %}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          {% render 'hold-link', book: featured, class: 'btn btn-primary whitespace-nowrap' %}
          <a href="/books/{{ featured.id }}" class="text-link font-semibold">Read {% if featured.picked_by %}{{ featured.picked_by }}'s{% else %}our{% endif %} note</a>
        </div>
        <ul class="mt-12 divide-y divide-base-300 border-t border-base-300">
          {%- assign rows = 0 -%}
          {%- for book in data.products -%}{%- if book.pick and book.id != featured.id and rows < 4 -%}{%- assign rows = rows | plus: 1 %}
          <li>
            <a href="/books/{{ book.id }}" class="group grid grid-cols-[3.5rem_1fr_auto] items-center gap-5 py-4">
              <span class="flex h-[5.25rem] items-end justify-center"><span class="block w-[calc(var(--f)*100%)]" data-format="{{ book.format }}">{% render 'jacket', book: book %}</span></span>
              <span class="min-w-0"><span class="block font-heading text-[1.25rem] font-semibold leading-tight group-hover:underline group-hover:decoration-primary group-hover:decoration-2 group-hover:underline-offset-4">{{ book.name }}</span><span class="mt-1 block text-[0.9375rem] text-base-content/75">{{ book.author }}</span></span>
              <span class="label text-base-content/75 max-sm:hidden">{% if book.picked_by %}{{ book.picked_by }}'s pick{% endif %}</span>
            </a>
          </li>
          {%- endif -%}{%- endfor %}
        </ul>
      </div>
    </div>
    {%- endif %}
  </div>
</section>
