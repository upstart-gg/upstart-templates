<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div data-reveal>
      <p class="label text-base-content/75">By bookseller</p>
      <h2 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3.25rem)]">Find your bookseller</h2>
      <p class="body-copy mt-4 max-w-[56ch]">Everyone here reads something different. Find the one who reads like you, and ask for them at the till.</p>
    </div>
    <ul class="mt-12 border-t border-base-content/80">
      {%- for member in data.team %}
      {%- assign theirs = data.products | where: "picked_by", member.first_name %}
      <li id="{{ member.first_name | downcase }}" class="grid scroll-mt-24 gap-6 border-b border-base-300 py-8 md:grid-cols-[4.5rem_minmax(0,1fr)_auto] md:items-center md:gap-8">
        {% if member.photo %}<img src="{{ member.photo }}" class="size-[4.5rem] rounded-box object-cover">{% else %}<span class="initials size-[4.5rem] rounded-box text-[1.75rem]" aria-hidden="true">{{ member.first_name | slice: 0 }}</span>{% endif %}
        <div class="min-w-0">
          <h3 class="text-[1.375rem]">{{ member.name }}</h3>
          <p class="mt-1 text-base-content/80"><span class="label">Reads mostly</span> {{ member.reads }}</p>
        </div>
        <ul class="flex items-end gap-4">
          {%- for book in theirs %}{% if book.pick %}
          <li class="w-16 sm:w-[4.5rem]"><a href="/books/{{ book.id }}" class="block w-[calc(var(--f)*100%)]" data-format="{{ book.format }}">{% render 'jacket', book: book %}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
