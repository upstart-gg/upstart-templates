<section id="rsvp" class="scroll-mt-24 bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="label text-base-content/75">RSVP</p>
      <h2 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3rem)]">Save your seats</h2>
      <p class="body-copy mt-4 max-w-[36ch]">Free events are first come; we keep RSVP'd seats until 6:55. Ticketed nights are paid at the door.</p>
    </div>
    <form hx-post="/_data/rsvps" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#rsvp-problems swap:innerHTML" class="grid gap-x-5 gap-y-1 rounded-box bg-base-100 p-6 sm:grid-cols-2 md:p-8 lg:col-span-8">
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend text-[0.9375rem]">The reading <span class="required-mark" aria-hidden="true">*</span></legend>
        <select name="reading" class="select w-full" required>
          {%- for event in data.events %}{% if event.rsvp != "walk-in" %}
          <option value="{{ event.title }}" data-event data-date="{{ event.date }}" data-starts="{{ event.starts }}" {% if event.id == chosen %}selected{% endif %}>{{ event.date | date: "%b %-d" }} · {{ event.title }}</option>
          {%- endif %}{% endfor %}
        </select>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-[0.9375rem]">Your name <span class="required-mark" aria-hidden="true">*</span></legend>
        <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-[0.9375rem]">Your email <span class="required-mark" aria-hidden="true">*</span></legend>
        <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-[0.9375rem]">How many seats</legend>
        <select name="seats" class="select w-full"><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option></select>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-[0.9375rem]">Access needs <span class="font-normal text-base-content/70">(optional)</span></legend>
        <input name="access" type="text" class="input w-full" maxlength="300" placeholder="A seat on the aisle, step-free">
      </fieldset>
      <label class="mt-3 flex items-center gap-3 sm:col-span-2"><input name="hold_book" type="checkbox" value="true" class="checkbox checkbox-primary"><span>Hold a copy of the book for me</span></label>
      <div id="rsvp-problems" class="sm:col-span-2"></div>
      <div class="mt-5 sm:col-span-2"><button class="btn btn-primary btn-lg whitespace-nowrap">Save my seats</button></div>
    </form>
  </div>
</section>
