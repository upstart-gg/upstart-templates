<div class="rounded-box bg-base-100 p-8 text-base-content md:p-10 lg:col-span-7" role="status">
  <p class="label text-base-content/75">Your card is on its way to the counter</p>
  <p class="mt-3 font-heading text-[1.75rem] leading-snug font-medium">Thank you, {{ record.name }}. We'll call you today to take payment{% if record.for_name %} for {{ record.for_name }}'s card{% endif %}.</p>
  <p class="body-copy mt-3">{% if record.delivery == "mail" %}It goes in the mail the same day, free.{% else %}It will be ready at the counter the same day.{% endif %}{% if record.message %} We'll write your message on it by hand.{% endif %}</p>
</div>
