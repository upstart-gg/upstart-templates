<section class="bg-secondary text-secondary-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-8" data-reveal>
      <div>
        <p class="label text-secondary-content/75">Book clubs</p>
        <h2 class="mt-3 max-w-[22ch] text-[clamp(2rem,2.5vw+1rem,3.25rem)]">Four book clubs, and nobody checks if you finished.</h2>
      </div>
      <a href="/clubs" class="btn btn-primary btn-lg whitespace-nowrap">Join a club</a>
    </div>
    <ul class="mt-14 grid gap-x-10 border-t border-secondary-content/25 md:grid-cols-2" data-reveal="stagger">
      {%- for club in data.clubs %}
      <li class="border-b border-secondary-content/25 py-7">
        <p class="facts text-secondary-content/80">{{ club.when }}</p>
        <h3 class="mt-1.5 text-[1.375rem]"><a href="/clubs#{{ club.id }}" class="hover:underline hover:decoration-2 hover:underline-offset-4">{{ club.name }}</a></h3>
        <p class="mt-2 text-secondary-content/85">{{ club.about }}{% if club.ages %} {{ club.ages }}.{% endif %}</p>
        <p class="label mt-3 text-secondary-content/80">Led by {{ club.leader }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
