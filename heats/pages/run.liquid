  </div>
</section>
<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-16 md:px-8 md:pb-24">{% render 'run-strip', set: "run", show: "all" %}</div>
</section>
{% render 'run-steps' %}
{% render 'prints' %}
{% render 'checksums' %}
{% render 'run-faq' %}
