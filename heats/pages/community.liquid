<!doctype html>
<html lang="en">
<head>
<title>Community — Dunlin</title>
<meta name="description" content="Fourteen maintainers, 212 contributors, ten time zones: where the Dunlin project talks, how decisions are made, and how to give code, compute or money.">
<meta property="og:title" content="Community — Dunlin">
<meta property="og:description" content="Fourteen maintainers, 212 contributors, ten time zones: where the Dunlin project talks, how decisions are made, and how to give code, compute or money.">
</head>
<body>
{% render 'header' %}
<main>
<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pt-8 pb-14 md:px-8 md:pb-20">
    <div class="spec flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-base-content/50 pb-3"><p>Dunlin · Community</p><p>Sheet 08 of 08</p></div>
    <div class="mt-10 grid gap-5 md:mt-14 lg:grid-cols-12 lg:gap-12">
      <h1 class="title-hero lg:col-span-5">Community</h1>
      <p class="body-copy text-[1.1875rem] lg:col-span-7 lg:pt-3">Fourteen maintainers, 212 contributors, ten time zones. Here is where we talk and how to join in.</p>
    </div>
  </div>
</section>
<section class="text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-5 px-5 pb-16 md:grid-cols-[7fr_5fr] md:px-8 md:pb-24">
    <figure>
      <img src="/media/dunlin-flock.jpg" class="aspect-[3/2] w-full object-cover md:aspect-auto md:h-[28rem]">
    </figure>
    <figure>
      <img src="/media/dunlin-feeding.jpg" class="aspect-[3/2] w-full object-cover md:aspect-auto md:h-[28rem]">
    </figure>
    <p class="caption-italic text-base-content/80 md:col-span-2">The dunlin crosses continents twice a year and flies in flocks that turn as one.</p>
  </div>
</section>
{% render 'channels' %}
{% render 'contribute-steps' %}
{% render 'time-zones' %}
{% render 'decisions' %}
{% render 'community-sponsors' %}
{% render 'sponsor-form' %}
{% render 'notes-strip' %}
</main>
{% render 'footer', sheet: "08" %}
</body>
</html>
