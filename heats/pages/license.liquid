<!doctype html>
<html lang="en">
<head>
<title>License — Dunlin</title>
<meta name="description" content="Dunlin's weights and code are under Apache-2.0. What you may, must and may not do, in plain words, then the full text.">
<meta property="og:title" content="License — Dunlin">
<meta property="og:description" content="Dunlin's weights and code are under Apache-2.0. What you may, must and may not do, in plain words, then the full text.">
</head>
<body>
{% render 'header' %}
<main>
<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pt-8 pb-14 md:px-8 md:pb-20">
    <div class="spec flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-base-content/50 pb-3"><p>Dunlin · License</p><p>Sheet 07 of 08</p></div>
    <div class="mt-10 grid gap-5 md:mt-14 lg:grid-cols-12 lg:gap-12">
      <h1 class="title-hero lg:col-span-5">License</h1>
      <p class="body-copy text-[1.1875rem] lg:col-span-7 lg:pt-3">Weights and code under Apache-2.0. The training data keeps its own licenses, listed in the manifest.</p>
    </div>
  </div>
</section>
<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-20 md:px-8 md:pb-28">
    <h2 class="title-section">In plain words</h2>
    <div class="mt-8">{% render 'license-columns', show: "more" %}</div>
  </div>
</section>
{% render 'license-faq' %}
{% render 'license-text' %}
</main>
{% render 'footer', sheet: "07" %}
</body>
</html>
