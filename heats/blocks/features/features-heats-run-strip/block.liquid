<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
    <h2 class="title-section">Run it</h2>
    <p class="body-copy mt-3">Pick the way you already use.</p>
    <div class="ground mt-8 px-5 pt-2 pb-5 md:px-6 md:pb-6">
      <div class="tabs run-tabs" data-run-tabs>
        {% for way in data.runtimes %}
<input type="radio" name="run-strip" class="tab" aria-label="{{ way.label }}" {% if forloop.first %}checked{% endif %}>
<div class="tab-content">
  <p class="comment text-secondary">{{ way.comment }}</p>
  <div class="mt-1.5 flex items-start justify-between gap-4" data-copy-from>
    <code class="command block min-w-0 select-all pt-1.5">{{ way.command }}</code>
    <button type="button" data-copy class="btn btn-paper btn-sm h-9 shrink-0 px-3" aria-live="polite"><span class="copy-idle">Copy</span><span class="copy-done">Copied</span></button>
  </div>
  {% if way.notes != blank %}<p class="mt-4 max-w-[64ch] leading-relaxed text-neutral-content/85">{{ way.notes }}</p>{% endif %}
</div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
