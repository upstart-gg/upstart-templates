<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-4 lg:grid-cols-2 lg:gap-12">
      <h2 class="title-section">The maintainers, by the hour</h2>
      <p class="body-copy lg:pt-2">A review asked for in Seattle in the evening is often done in Seoul before Seattle wakes up.</p>
    </div>
    <div class="relative mt-14 hidden px-20 xl:block">
      <div class="relative h-[13.5rem]">
        {% for person in data.maintainers %}{% assign odd = forloop.index0 | modulo: 2 %}{% if odd == 0 %}
        <div class="ruler-mark bottom-0" style="--at: {{ person.utc | plus: 8 }}">
          {%- assign words = person.name | split: " " -%}
{% if person.photo %}<img src="{{ person.photo }}" class="size-12 shrink-0 object-cover">{% else %}<span class="grid size-12 shrink-0 place-items-center border border-base-content/50 bg-base-200 font-heading text-[1.0625rem] font-semibold" aria-hidden="true">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span>{% endif %}
          <h3 class="title-small mt-2.5 whitespace-nowrap">{{ person.name }}</h3>
          <p class="text-[0.9375rem] leading-snug text-base-content/80">{{ person.area }}<br>{{ person.city }} · {{ person.pronouns }}</p>
          <span class="ruler-stem mt-2" aria-hidden="true"></span>
        </div>
        {% endif %}{% endfor %}
      </div>
      <div class="ruler-line" aria-hidden="true">
        {% for hour in (0..17) %}{% assign offset = hour | minus: 8 %}<span class="ruler-tick" style="--at: {{ hour }}"><span class="mono text-[0.75rem]">{% if offset > 0 %}+{{ offset }}{% elsif offset < 0 %}−{{ offset | abs }}{% else %}UTC{% endif %}</span></span>{% endfor %}
      </div>
      <div class="relative h-[13.5rem]">
        {% for person in data.maintainers %}{% assign odd = forloop.index0 | modulo: 2 %}{% if odd == 1 %}
        <div class="ruler-mark top-0" style="--at: {{ person.utc | plus: 8 }}">
          <span class="ruler-stem mb-2" aria-hidden="true"></span>
          {%- assign words = person.name | split: " " -%}
{% if person.photo %}<img src="{{ person.photo }}" class="size-12 shrink-0 object-cover">{% else %}<span class="grid size-12 shrink-0 place-items-center border border-base-content/50 bg-base-200 font-heading text-[1.0625rem] font-semibold" aria-hidden="true">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span>{% endif %}
          <h3 class="title-small mt-2.5 whitespace-nowrap">{{ person.name }}</h3>
          <p class="text-[0.9375rem] leading-snug text-base-content/80">{{ person.area }}<br>{{ person.city }} · {{ person.pronouns }}</p>
        </div>
        {% endif %}{% endfor %}
      </div>
    </div>
    <ul class="mt-8 border-b border-base-content/35 xl:hidden">
      {% for person in data.maintainers %}
      <li class="grid grid-cols-[4.5rem_auto_1fr] items-center gap-x-4 border-t border-base-content/35 py-4">
        <span class="mono text-[0.9375rem]">{% if person.utc > 0 %}UTC+{{ person.utc }}{% elsif person.utc < 0 %}UTC−{{ person.utc | abs }}{% else %}UTC{% endif %}</span>
        {%- assign words = person.name | split: " " -%}
{% if person.photo %}<img src="{{ person.photo }}" class="size-12 shrink-0 object-cover">{% else %}<span class="grid size-12 shrink-0 place-items-center border border-base-content/50 bg-base-200 font-heading text-[1.0625rem] font-semibold" aria-hidden="true">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span>{% endif %}
        <div>
          <h3 class="title-small">{{ person.name }}</h3>
          <p class="text-[0.9375rem] leading-snug text-base-content/80">{{ person.area }}<br>{{ person.city }} · {{ person.pronouns }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
    <p class="mt-8"><a href="https://github.com/dunlin-project/community/blob/main/MAINTAINERS.md" class="text-link font-semibold">And six more</a></p>
  </div>
</section>
