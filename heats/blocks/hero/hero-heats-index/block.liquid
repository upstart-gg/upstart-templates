<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pt-6 pb-16 md:px-8 md:pt-8 md:pb-24">
    <div class="spec zones mb-1 hidden xl:flex" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span></div>
    <div class="relative">
      <div class="spec zones absolute inset-y-0 -left-5 hidden flex-col xl:flex" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span></div>
      <div class="border border-base-content/50 px-5 pt-4 pb-6 md:px-8 md:pt-5 md:pb-8">
        <div class="flex flex-wrap justify-between gap-x-6 gap-y-1">
          <p class="spec">Dunlin 3 · open-weights language models · Apache-2.0</p>
          <p class="spec">Sheet 01 of 08</p>
        </div>
        <div class="mt-6 grid gap-8 lg:grid-cols-12 md:mt-8 lg:gap-12">
          <h1 class="title-hero lg:col-span-6">Five open models, small enough to run where you are.</h1>
          <div class="lg:col-span-6">
            <p class="body-copy">From a 1.6B that fits on a phone to a 62B mixture of experts for a workstation. Weights, data manifest, training code and every eval config, published by fourteen maintainers in ten time zones.</p>
            <div class="mt-5 max-sm:-mx-[1.1875rem]">{% for model in data.models %}{% if model.featured %}
{% assign size = model.ollama | split: ":" | last %}
<div class="ground px-5 pt-2 pb-5 md:px-6 md:pb-6">
  <div class="tabs run-tabs" data-run-tabs>
<input type="radio" name="run-hero-index" class="tab" aria-label="Ollama" checked>
<div class="tab-content">
  <p class="comment text-secondary"># {{ model.q4 }} at 4-bit · {{ model.runs_on | slice: 0 | downcase }}{{ model.runs_on | slice: 1, 200 }}</p>
  <div class="mt-1.5 flex items-start justify-between gap-4" data-copy-from>
    <code class="command block min-w-0 select-all pt-1.5">ollama run {{ model.ollama }}</code>
    <button type="button" data-copy class="btn btn-paper btn-sm h-9 shrink-0 px-3" aria-live="polite"><span class="copy-idle">Copy</span><span class="copy-done">Copied</span></button>
  </div>
</div>
<input type="radio" name="run-hero-index" class="tab" aria-label="Python" >
<div class="tab-content">
  <p class="comment text-secondary"># {{ model.q4 }} at 4-bit · {{ model.runs_on | slice: 0 | downcase }}{{ model.runs_on | slice: 1, 200 }}</p>
  <div class="mt-1.5 flex items-start justify-between gap-4" data-copy-from>
    <code class="command block min-w-0 select-all pt-1.5">dunlin-lm chat --size {{ size }}</code>
    <button type="button" data-copy class="btn btn-paper btn-sm h-9 shrink-0 px-3" aria-live="polite"><span class="copy-idle">Copy</span><span class="copy-done">Copied</span></button>
  </div>
</div>
<input type="radio" name="run-hero-index" class="tab" aria-label="Hugging Face" >
<div class="tab-content">
  <p class="comment text-secondary"># {{ model.bf16 }} at BF16 · for fine-tuning</p>
  <div class="mt-1.5 flex items-start justify-between gap-4" data-copy-from>
    <code class="command block min-w-0 select-all pt-1.5">hf download {{ model.hf }}</code>
    <button type="button" data-copy class="btn btn-paper btn-sm h-9 shrink-0 px-3" aria-live="polite"><span class="copy-idle">Copy</span><span class="copy-done">Copied</span></button>
  </div>
</div>
<input type="radio" name="run-hero-index" class="tab" aria-label="llama.cpp" >
<div class="tab-content">
  <p class="comment text-secondary"># {{ model.q4 }} at 4-bit · {{ model.runs_on | slice: 0 | downcase }}{{ model.runs_on | slice: 1, 200 }}</p>
  <div class="mt-1.5 flex items-start justify-between gap-4" data-copy-from>
    <code class="command block min-w-0 select-all pt-1.5">llama-cli -hf {{ model.gguf }}</code>
    <button type="button" data-copy class="btn btn-paper btn-sm h-9 shrink-0 px-3" aria-live="polite"><span class="copy-idle">Copy</span><span class="copy-done">Copied</span></button>
  </div>
</div>
  </div>
</div>
{% endif %}{% endfor %}</div>
            <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2"><a href="/run" class="text-link font-semibold">Every way to run it</a><a href="/models/dunlin-3" class="text-link font-semibold">Read the model card</a></p>
          </div>
        </div>
        <div class="mt-8"><div class="xl:grid-cols-[3rem_minmax(16rem,1.4fr)_7.5rem_6rem_6.5rem_minmax(14rem,1fr)_1.5rem] hidden gap-x-5 pb-2 text-base-content/75 xl:grid" aria-hidden="true">
  <span class="spec">No.</span>
  <span class="spec">Model</span>
  <span class="spec">Parameters</span>
  <span class="spec">Context</span>
  <span class="spec">At 4-bit</span>
  <span class="spec">Runs on</span>
</div>
<ol class="border-b border-base-content/35" data-reveal="stagger" data-index>
  {% for model in data.models %}
  <li>
    <a href="/models/{{ model.id }}" class="index-row xl:grid-cols-[3rem_minmax(16rem,1.4fr)_7.5rem_6rem_6.5rem_minmax(14rem,1fr)_1.5rem] grid-cols-[2.25rem_1fr_1fr] gap-x-4 gap-y-3 py-4 md:grid-cols-[3rem_repeat(4,1fr)] xl:items-center xl:gap-x-5 xl:gap-y-0 xl:py-3">
      <span class="mono pt-1.5 text-[0.9375rem] text-base-content/75 xl:pt-0">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
      <span class="col-span-2 flex flex-wrap items-center gap-x-3 gap-y-1.5 md:col-span-4 xl:col-span-1">
        <span class="model-name">{{ model.name }}</span>
        {% if model.featured %}<span class="spec border border-primary px-1.5 py-px text-primary">Most people start here</span>{% endif %}
      </span>
      <span class="col-start-2 xl:col-start-auto"><span class="spec block text-base-content/75 xl:sr-only">Parameters</span><span class="mono">{{ model.params }}</span></span>
      <span><span class="spec block text-base-content/75 xl:sr-only">Context</span><span class="mono">{{ model.context }}</span></span>
      <span class="max-md:col-start-2"><span class="spec block text-base-content/75 xl:sr-only">At 4-bit</span><span class="mono whitespace-nowrap">{{ model.q4 }}</span></span>
      <span><span class="spec block text-base-content/75 xl:sr-only">Runs on</span>{{ model.runs_on }}</span>
      <svg class="index-arrow hidden size-5 xl:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg>
    </a>
  </li>
  {% endfor %}
</ol>
</div>
        <div class="mt-8 flex justify-end">
          <div class="w-full lg:w-[38rem]"><dl class="grid grid-cols-2 border-t border-l border-base-content/50 bg-base-200">
  <div class="border-r border-b border-base-content/50 px-3.5 py-2.5">
    <dt class="spec text-base-content/75">Rev</dt>
    <dd class="mono mt-0.5 text-[0.9375rem]">3.1</dd>
  </div>
  <div class="border-r border-b border-base-content/50 px-3.5 py-2.5">
    <dt class="spec text-base-content/75">Released</dt>
    <dd class="mono mt-0.5 text-[0.9375rem]">Mar 4, 2027</dd>
  </div>
  <div class="border-r border-b border-base-content/50 px-3.5 py-2.5">
    <dt class="spec text-base-content/75">License</dt>
    <dd class="mono mt-0.5 text-[0.9375rem]">Apache-2.0, weights and code</dd>
  </div>
  <div class="border-r border-b border-base-content/50 px-3.5 py-2.5">
    <dt class="spec text-base-content/75">Trained on</dt>
    <dd class="mono mt-0.5 text-[0.9375rem]">9.4T tokens, 92% public</dd>
  </div>
  <div class="border-r border-b border-base-content/50 px-3.5 py-2.5">
    <dt class="spec text-base-content/75">Checkpoints</dt>
    <dd class="mono mt-0.5 text-[0.9375rem]">Every 50B tokens</dd>
  </div>
  <div class="border-r border-b border-base-content/50 px-3.5 py-2.5">
    <dt class="spec text-base-content/75">Maintainers</dt>
    <dd class="mono mt-0.5 text-[0.9375rem]">14, in ten time zones</dd>
  </div>
</dl></div>
        </div>
      </div>
    </div>
  </div>
</section>
