<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/92 text-base-content">
  <div class="mx-auto flex h-16 max-w-[84rem] items-center gap-4 px-5 md:px-8">
    <a href="/" class="flex items-center gap-2">
      {% render 'mark' %}
      <span class="wordmark text-[1.625rem]">Dunlin</span>
    </a>
    <nav aria-label="Main" class="ml-6 hidden xl:block">
      <ul class="flex items-center gap-1 whitespace-nowrap">
        {% for item in data.navigation %}{% if item.place == "header" or item.place == "both" %}
        <li><a href="{{ item.href }}" class="border-b-2 px-3 py-2 transition-colors hover:text-primary {% if page.url == item.href %}border-primary{% else %}border-transparent{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a href="/run" class="btn btn-primary px-4">Get the weights</a>
      <div class="dropdown dropdown-end xl:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost size-11 min-h-11 p-0" aria-label="Open the menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-50 mt-3 w-64 border border-base-content bg-base-100 p-2">
          {% for item in data.navigation %}{% if item.place == "header" or item.place == "both" %}
          <li><a href="{{ item.href }}" class="text-base" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</header>
