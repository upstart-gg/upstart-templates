<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-16 md:px-8 md:pb-24">
    <h2 class="title-section">The lanes</h2>
    <ol class="mt-8 grid border-t border-base-content/50 sm:grid-cols-2 xl:grid-cols-4">
      {% for lane in data.lanes %}
      <li class="border-base-content/35 py-5 max-xl:border-b sm:pr-6 xl:py-6 {% unless forloop.first %}xl:border-l xl:pl-6{% endunless %}">
        <p class="spec text-base-content/75">Lane {{ forloop.index }}</p>
        <div class="pattern-{{ lane.pattern }} mt-3 h-6" aria-hidden="true"></div>
        <h3 class="title-small mt-3.5">{{ lane.name }}</h3>
        <p class="mt-1 leading-relaxed text-base-content/80">{{ lane.note }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
