<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
    <h2 class="title-section">How decisions are made</h2>
    <div class="mt-10 grid border-t border-base-content/50 md:grid-cols-3">
      {% for note in data.decisions %}
      <div class="py-6 max-md:border-b max-md:border-base-content/35 md:px-7 md:py-8 {% if forloop.first %}md:pl-0{% else %}md:border-l md:border-base-content/35{% endif %}">
        <h3 class="title-small">{{ note.title }}</h3>
        <p class="mt-3 leading-relaxed text-base-content/80">{{ note.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
