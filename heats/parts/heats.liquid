{%- comment -%} The heats, two by two. show: "home", "quality", "speed", or "pick" with ids (heats' ids separated by commas) {%- endcomment -%}
{%- assign picked = ids | default: "" | split: "," -%}
<div class="grid gap-x-12 gap-y-10 lg:grid-cols-2 lg:gap-y-14">
  {% for heat in data.heats %}
  {%- assign shown = false -%}
  {%- if show == "home" and heat.home -%}{%- assign shown = true -%}{%- endif -%}
  {%- if show == heat.group -%}{%- assign shown = true -%}{%- endif -%}
  {%- if show == "pick" and picked contains heat.id -%}{%- assign shown = true -%}{%- endif -%}
  {% if shown %}{% render 'heat-lanes', heat: heat, number: forloop.index %}{% endif %}
  {% endfor %}
</div>
