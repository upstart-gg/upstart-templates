<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-8 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-12">
    <h2 class="title-section lg:col-span-4">Questions about the evals</h2>
    <div class="border-b border-base-content/35 lg:col-span-8">
      {% for question in data["evals-faq"] %}{% render 'question', question: question, open: forloop.first %}{% endfor %}
    </div>
  </div>
</section>
