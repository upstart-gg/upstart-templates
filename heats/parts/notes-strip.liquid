<section id="notes" class="scroll-mt-16 border-t border-base-300 bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-6 px-5 py-12 md:px-8 md:py-16 lg:grid-cols-[5fr_7fr] lg:gap-14">
    <div>
      <h2 class="title-section">Release notes by email</h2>
      <p class="mt-3 text-[1.125rem] leading-relaxed text-base-content/80">One email per revision, nothing else.</p>
    </div>
    <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#newsletter-problems swap:innerHTML">
      <label class="field-label block" for="newsletter-email">Email</label>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <input id="newsletter-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input h-11 w-full min-w-0 bg-base-100 text-base sm:flex-1">
        <button class="btn btn-primary h-11">Send me the notes</button>
      </div>
      <fieldset class="mt-4">
        <legend class="field-label">The sizes you care about <span class="font-normal text-base-content/75">(all, if none)</span></legend>
        <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
          {% for model in data.models %}<label class="flex items-center gap-2"><input type="checkbox" name="sizes" value="{{ model.name }}" class="checkbox checkbox-primary checkbox-sm bg-base-100">{{ model.name }}</label>{% endfor %}
        </div>
      </fieldset>
      <div id="newsletter-problems" class="mt-3"></div>
    </form>
  </div>
</section>
