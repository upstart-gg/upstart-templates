<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-x-10 px-5 py-20 md:px-8 md:py-28 xl:grid-cols-[8rem_minmax(0,1fr)]">
    <p class="spec pt-2 text-base-content/75">08 · People</p>
    <div class="min-w-0 max-xl:mt-4">
      <h2 class="title-section">Built by 212 people, in the open.</h2>
      <div class="mt-10 grid gap-10 lg:grid-cols-[5fr_7fr] lg:items-center lg:gap-14">
        <dl class="grid grid-cols-2 border-t border-l border-base-content/35">
          {% for item in data["home-figures"] %}
          <div class="flex flex-col-reverse justify-end gap-2 border-r border-b border-base-content/35 p-5 md:p-6">
            <dt class="leading-snug text-base-content/80">{{ item.label }}</dt>
            <dd class="figure-large">{{ item.figure }}</dd>
          </div>
          {% endfor %}
        </dl>
        <figure>
          <img src="/media/dunlin-plate-2.webp" class="ink w-full" loading="lazy">
          <figcaption class="caption-italic mt-3 text-base-content/80">Plate 2 · The flock, which turns as one</figcaption>
        </figure>
      </div>
      <h2 class="title-section mt-20 md:mt-28">Who paid for the compute.</h2>
      <div class="mt-8">{% render 'sponsors' %}</div>
      <p class="mt-8"><a href="/community#sponsor" class="btn btn-outline">Offer compute</a></p>
    </div>
  </div>
</section>
