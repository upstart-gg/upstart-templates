<input type="radio" name="run-{{ set }}" class="tab" aria-label="{{ label }}" {% if first %}checked{% endif %}>
<div class="tab-content">
  <p class="comment text-secondary">{{ comment }}</p>
  <div class="mt-1.5 flex items-start justify-between gap-4" data-copy-from>
    <code class="command block min-w-0 select-all pt-1.5">{{ command }}</code>
    {% render 'copy-button', on: "ground" %}
  </div>
  {% if notes != blank %}<p class="mt-4 max-w-[64ch] leading-relaxed text-neutral-content/85">{{ notes }}</p>{% endif %}
</div>
