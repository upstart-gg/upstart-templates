<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
    <h2 class="title-section">Questions about running it</h2>
    {% assign topics = data["run-faq"] | map: "topic" | compact | uniq %}
    <div class="mt-10 space-y-10">
      {% for topic in topics %}
      {% assign questions = data["run-faq"] | where: "topic", topic %}
      {% if questions.size > 0 %}
      <div class="grid gap-x-12 gap-y-4 lg:grid-cols-12">
        <h3 class="spec pt-6 text-base-content/75 max-lg:pt-0 lg:col-span-3">{{ topic }}</h3>
        <div class="border-b border-base-content/35 lg:col-span-9">
          {% for question in questions %}{% render 'question', question: question %}{% endfor %}
        </div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
