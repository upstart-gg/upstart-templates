<section class="text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
    <h2 class="title-section">Contents</h2>
    <ol class="mt-8 border-b border-base-content/35" data-reveal="stagger" data-index>
      {% for section in data["report-sections"] %}
      <li class="grid grid-cols-[2.25rem_1fr_auto] items-baseline gap-x-4 gap-y-1 border-t border-base-content/35 py-4 md:grid-cols-[3rem_minmax(0,1.1fr)_minmax(0,1.3fr)_4rem] md:gap-x-6">
        <span class="mono text-[0.9375rem] text-base-content/75">0{{ forloop.index }}</span>
        <h3 class="model-name text-[clamp(1.375rem,1vw+1rem,1.75rem)]">{{ section.title }}</h3>
        <p class="leading-relaxed text-base-content/80 max-md:col-span-2 max-md:col-start-2 max-md:row-start-2">{{ section.summary }}</p>
        <span class="mono text-right">p. {{ section.page }}</span>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
