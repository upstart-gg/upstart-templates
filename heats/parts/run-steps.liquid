<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
    <h2 class="title-section">From zero to a first answer</h2>
    <ol class="mt-10 grid gap-x-10 gap-y-10 md:grid-cols-2 xl:grid-cols-4" data-reveal="stagger">
      {% for step in data["run-steps"] %}
      <li class="flex flex-col border-t border-base-content/50 pt-5">
        <span class="figure-large" aria-hidden="true">{{ forloop.index }}</span>
        <h3 class="title-small mt-4">{{ step.title }}</h3>
        <p class="mt-2 leading-relaxed text-base-content/80">{{ step.text }}</p>
        {% if step.command != blank %}<div class="mt-auto flex items-start justify-between gap-3 pt-5" data-copy-from><code class="command min-w-0 select-all pt-1">{{ step.command }}</code>{% render 'copy-button' %}</div>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
