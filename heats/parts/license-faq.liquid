<section class="bg-secondary text-secondary-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
    <h2 class="title-section">Using it in a product</h2>
    <dl class="mt-10 grid gap-x-14 gap-y-10 md:grid-cols-2">
      {% for item in data["license-faq"] %}
      <div class="border-t border-secondary-content/40 pt-5">
        <dt class="title-small">{{ item.question }}</dt>
        <dd class="mt-3 max-w-[56ch] leading-relaxed">{{ item.answer }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
