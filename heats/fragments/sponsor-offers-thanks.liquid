{%- assign first_name = record.name | split: " " | first -%}
<div class="bg-base-200 p-6 text-base-content md:p-8" role="status">
  <p class="title-small">Thank you, {{ first_name }}.</p>
  <p class="mt-3 max-w-[56ch] leading-relaxed text-base-content/80">Your offer is with the steering group. One of its five maintainers will answer at {{ record.email }} within a week, and what comes of it will be in the quarterly accounts.</p>
</div>
