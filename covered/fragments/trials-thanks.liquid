{%- assign first_name = record.name | split: " " | first -%}
<div class="rounded-box bg-secondary p-6 text-secondary-content md:p-8" role="status">
  <p class="heading-small">Thanks, {{ first_name }}.</p>
  <p class="mt-3 leading-relaxed">We&rsquo;ll text you at the number you gave within a working hour, with your log-in. Want us to type in your first week? Text us a photo of the paper on the wall.</p>
</div>
