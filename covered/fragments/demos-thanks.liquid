{%- assign first_name = record.name | split: " " | first -%}
<div class="rounded-box bg-base-100 p-6 md:p-8" role="status">
  <p class="heading-small">Thanks, {{ first_name }}. We&rsquo;ll call you.</p>
  <p class="mt-3 leading-relaxed text-base-content/80">A person from our team will write to {{ record.email }} today to set a time{% if record.when %} {{ record.when | downcase }}{% endif %}. Twenty minutes, and we&rsquo;ll build a week of {{ record.business }} with you on the call.</p>
</div>
