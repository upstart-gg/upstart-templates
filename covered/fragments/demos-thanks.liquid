{%- assign first_name = record.name | split: " " | first -%}
<div class="rounded-box bg-base-100 p-6 md:p-8" role="status">
  <p class="heading-small">Thanks, {{ first_name }}. We&rsquo;ll call you.</p>
  <p class="mt-3 leading-relaxed text-base-content/80">A person from our team will write to {{ record.email }} today to set a time{% case record.when %}{% when "Before the lunch rush" %} before your lunch rush{% when "The afternoon lull" %} in your afternoon lull{% when "After close" %} after you close{% endcase %}. Twenty minutes, and we&rsquo;ll build a week of {{ record.business }} with you on the call.</p>
</div>
