<td class="px-4 py-3.5 text-center">
  {%- if cell == "yes" -%}<svg class="mx-auto size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span class="sr-only">Included</span>
  {%- elsif cell == blank -%}<svg class="mx-auto size-5 text-base-content/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 12h10"/></svg><span class="sr-only">Not included</span>
  {%- else -%}<span class="text-[0.9375rem] font-medium">{{ cell }}</span>{%- endif -%}
</td>
