<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-24">
    <h2 class="heading-section max-w-[18ch]">Every plan includes</h2>
    <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {%- for item in data["pricing-included"] -%}
      <li class="flex gap-3.5"><span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-primary text-primary-content"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span><span><span class="block text-[1.0625rem] font-semibold">{{ item.title }}</span><span class="mt-1 block text-[0.9375rem] leading-relaxed text-base-content/80">{{ item.text }}</span></span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
