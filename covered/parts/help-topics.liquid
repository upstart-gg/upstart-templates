{%- comment -%} The articles by topic, over `help-articles`: each a summary and a link to its page. {%- endcomment -%}
{%- assign topics = "Getting started,The schedule,Timesheets & pay,The crew's app,Billing" | split: "," -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-20 md:px-8 md:pb-28">
    <div class="grid gap-x-12 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
      {%- for topic in topics -%}
      {%- assign articles = data["help-articles"] | where: "topic", topic -%}
      {%- if articles.size > 0 -%}
      <div>
        <h2 class="border-b-2 border-base-content pb-3 text-[1.375rem]">{{ topic }}</h2>
        <ul class="divide-y divide-base-300">
          {%- for article in articles -%}
          <li><a href="/help/{{ article.id }}" class="group block py-4"><span class="block font-semibold group-hover:text-primary">{{ article.title }}</span><span class="mt-1 block text-[0.9375rem] leading-relaxed text-base-content/75">{{ article.summary }}</span></a></li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
