{%- comment -%} Three ways to talk to a person, from `contact-ways`: a card with a link for each, the one with none highlighted. {%- endcomment -%}
<section id="talk" class="scroll-mt-20 bg-base-200 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-24">
    <p class="kicker text-primary">Talk to a person</p>
    <h2 class="heading-section mt-3 max-w-[22ch]">Everyone who answers has worked a Saturday double.</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {%- for way in data["contact-ways"] %}
      {%- if way.href %}
      <a href="{{ way.href }}" class="group rounded-box border border-base-300 bg-base-100 p-7 hover:border-primary">
        <p class="kicker text-base-content/75">{{ way.label }}</p>
        <p class="{% if forloop.first %}figure mt-3 text-[1.75rem]{% else %}mt-3 text-[1.375rem] font-semibold break-words{% endif %} group-hover:text-primary">{{ way.title }}</p>
        {%- if way.text %}<p class="mt-3 text-[0.9375rem] leading-relaxed text-base-content/80">{{ way.text }}</p>{% endif %}
      </a>
      {%- else %}
      <div class="rounded-box bg-secondary p-7 text-secondary-content">
        <p class="kicker">{{ way.label }}</p>
        <p class="mt-3 text-[1.375rem] font-semibold">{{ way.title }}</p>
        {%- if way.text %}<p class="mt-3 text-[0.9375rem] leading-relaxed">{{ way.text }}</p>{% endif %}
      </div>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</section>
