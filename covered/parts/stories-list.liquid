{%- comment -%} The stories, a row each with its square cover, over `stories`. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-20 md:px-8 md:pb-28">
    <ul class="divide-y divide-base-300 border-y border-base-300">
      {%- for story in data.stories -%}
      <li>
        <a href="/customers/{{ story.id }}" class="group grid gap-6 py-8 md:grid-cols-12 md:items-center md:gap-10 md:py-10">
          <div class="md:col-span-4 lg:col-span-3">{%- if story.cover -%}<img src="{{ story.cover }}" class="aspect-square w-full rounded-box object-cover">{%- else -%}<div class="aspect-square w-full rounded-box bg-gradient-to-br from-secondary to-base-200"></div>{%- endif -%}</div>
          <div class="md:col-span-8 lg:col-span-9">
            <p class="kicker text-base-content/75">{{ story.business }} · {{ story.city }} · {{ story.team }} people</p>
            <p class="mt-3 max-w-[34ch] font-heading text-[clamp(1.375rem,1.2vw+1rem,2rem)] leading-tight font-semibold tracking-[-0.015em] group-hover:text-primary">&ldquo;{{ story.quote }}&rdquo;</p>
            <div class="mt-5 flex items-center gap-3">
              {% render 'avatar', story: story, box: "size-10" %}
              <p class="leading-snug"><span class="font-semibold">{{ story.person }}</span><span class="text-base-content/75">, {{ story.role }}</span></p>
            </div>
            <span class="text-link mt-5 inline-flex font-semibold">Read the story</span>
          </div>
        </a>
      </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
