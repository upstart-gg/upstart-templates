{%- comment -%} The dated changes of `changes`, newest first, each with its plain pill and the job it touches. No version numbers. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-20 md:px-8 md:pb-28">
    <ol class="border-t border-base-300">
      {%- for change in data.changes -%}
      <li class="grid gap-3 border-b border-base-300 py-8 md:grid-cols-12 md:gap-10 md:py-10">
        <p class="figure text-[1.25rem] md:col-span-3">{{ change.date | date: "%b %-d, %Y" }}</p>
        <div class="md:col-span-8">
          <p class="flex flex-wrap items-center gap-2">
            <span class="rounded-full px-2.5 py-0.5 text-[0.75rem] font-semibold capitalize {% if change.kind == 'new' %}bg-primary text-primary-content{% elsif change.kind == 'better' %}bg-secondary text-secondary-content{% else %}bg-base-200 text-base-content{% endif %}">{{ change.kind }}</span>
            <span class="kicker text-base-content/75">{{ change.job }}</span>
          </p>
          <h2 class="mt-3 text-[1.5rem]">{{ change.title }}</h2>
          <div class="body-copy mt-2.5">{{ change.body }}</div>
        </div>
      </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
