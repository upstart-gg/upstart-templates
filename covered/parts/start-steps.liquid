<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-28">
    <p class="kicker text-primary">What happens next</p>
    <h2 class="heading-section mt-3 max-w-[20ch]">From the request to the crew&rsquo;s phones</h2>
    <ol class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8" data-reveal="stagger">
      {%- for step in data["start-steps"] -%}
      <li class="relative border-t-2 border-primary pt-5">
        <span class="figure text-[2rem] text-primary">{{ forloop.index | prepend: "0" }}</span>
        <h3 class="mt-3 text-[1.125rem]">{{ step.title }}</h3>
        <p class="mt-2 leading-relaxed text-base-content/80">{{ step.text }}</p>
      </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
