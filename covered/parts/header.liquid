<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 text-base-content">
  <div class="mx-auto flex h-16 max-w-[84rem] items-center gap-4 px-5 md:h-[4.5rem] md:px-8">
    {% render 'logo' %}
    <nav aria-label="Main" class="ml-6 hidden xl:block">
      <ul class="flex items-center gap-1 whitespace-nowrap text-[0.9375rem] font-medium">
        {% for item in data.navigation %}{% if item.place == "header" or item.place == "both" %}
        <li><a href="{{ item.href }}" class="rounded-field px-3.5 py-2 transition-colors hover:bg-base-200 {% if page.url == item.href %}bg-base-200{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a href="/help/logging-in" class="hidden whitespace-nowrap rounded-field px-3.5 py-2 text-[0.9375rem] font-medium transition-colors hover:bg-base-200 sm:inline-flex">Log in</a>
      <a href="/start#trial" class="btn btn-primary h-10 min-h-10 px-4">Start free trial</a>
      <div class="dropdown dropdown-end xl:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost size-11 min-h-11 p-0" aria-label="Open the menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-50 mt-3 w-64 rounded-box border border-base-300 bg-base-100 p-2 soft-shadow">
          {% for item in data.navigation %}{% if item.place == "header" or item.place == "both" %}
          <li><a href="{{ item.href }}" class="text-base" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
          <li><a href="/help/logging-in" class="text-base">Log in</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>
