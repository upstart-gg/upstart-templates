<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="heading-section max-w-[14ch]">Billing questions</h2>
      </div>
      <div class="divide-y divide-base-300 border-y border-base-300 lg:col-span-8">
        {%- for item in data["pricing-faq"] -%}
        <details class="group py-1" {% if forloop.first %}open{% endif %}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[1.125rem] font-semibold">{{ item.question }}<svg class="size-5 shrink-0 text-primary transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg></summary>
          <div class="pb-5 leading-relaxed text-base-content/80">{{ item.answer }}</div>
        </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
