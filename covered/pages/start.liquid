<!doctype html>
<html lang="en">
<head>
<title>Start a free trial — Staff Meal</title>
<meta name="description" content="Try Staff Meal yourself for 30 days, or have us show you on a 20-minute call. Either way, a person sets up your first week with you. No credit card.">
<meta property="og:title" content="Start with one week — Staff Meal">
<meta property="og:description" content="Try it yourself for 30 days, or have us show you on a call. A person sets up your first week with you.">
</head>
<body>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-10 px-5 pt-16 pb-12 md:px-8 md:pt-24 lg:grid-cols-12 lg:items-center lg:gap-14">
    <div class="lg:col-span-7">
      <p class="kicker text-primary">Start</p>
      <h1 class="mt-3 max-w-[16ch] text-[clamp(2.25rem,2.8vw+1rem,4rem)]">Start with one week</h1>
      <p class="body-copy mt-5 text-[1.125rem]">Try it yourself for 30 days, or have us show you on a call. Either way, a person sets up your first week with you.</p>
    </div>
    <div class="lg:col-span-5">
      <img src="/media/paper-schedule.webp" class="aspect-[4/3] w-full rounded-box object-cover">
    </div>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-6 px-5 pb-8 md:px-8 lg:grid-cols-2 lg:items-start">
    {% render 'trial-form' %}
    {% render 'demo-form' %}
  </div>
</section>
{% render 'start-steps' %}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-20">
    <ul class="grid gap-8 md:grid-cols-3">
      <li class="flex gap-3.5"><svg class="mt-0.5 size-6 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="m4 4 16 16"/></svg><span><span class="block text-[1.0625rem] font-semibold">No credit card</span><span class="mt-1 block text-base-content/80">We never ask for one during the trial.</span></span></li>
      <li class="flex gap-3.5"><svg class="mt-0.5 size-6 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg><span><span class="block text-[1.0625rem] font-semibold">Cancel any time, nothing charged</span><span class="mt-1 block text-base-content/80">After 30 days your account waits for a plan.</span></span></li>
      <li class="flex gap-3.5"><svg class="mt-0.5 size-6 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg><span><span class="block text-[1.0625rem] font-semibold">A person on the phone</span><span class="mt-1 block text-base-content/80">7 am to 10 pm Central, at <a href="tel:+18165550134" class="text-link whitespace-nowrap">(816) 555-0134</a>.</span></span></li>
    </ul>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
