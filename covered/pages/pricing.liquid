<!doctype html>
<html lang="en">
<head>
<title>Pricing — Staff Meal</title>
<meta name="description" content="Staff Meal is priced per location, with your whole crew included: Counter $29, Full house $59, Group $45 a location from three places. 30 days of Full house free, no card.">
<meta property="og:title" content="Staff Meal pricing — per location, your whole crew included">
<meta property="og:description" content="Every plan starts with 30 days of Full house, free, with no card.">
</head>
<body>
{% render 'header' %}
<main>
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pt-16 md:px-8 md:pt-24">
    <p class="kicker text-primary">Pricing</p>
    <h1 class="mt-3 max-w-[20ch] text-[clamp(2.25rem,2.8vw+1rem,4rem)]">Priced per location. Your whole crew included.</h1>
    <p class="body-copy mt-5 text-[1.125rem]">Every plan starts with 30 days of Full house, free, with no card.</p>
  </div>
</section>
{% render 'plans-toggle' %}
{% render 'compare' %}
{% render 'included' %}
{% render 'billing-faq' %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pb-20 md:px-8 md:pb-28">
    <div class="flex flex-col gap-6 rounded-box bg-secondary px-7 py-10 text-secondary-content md:flex-row md:items-center md:justify-between md:px-12">
      <h2 class="text-[clamp(1.5rem,1.4vw+1rem,2.25rem)] max-w-[24ch]">More than three places? We&rsquo;ll show you around.</h2>
      <a href="/start#demo" class="btn btn-primary btn-lg h-13 px-6">Get a demo</a>
    </div>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
