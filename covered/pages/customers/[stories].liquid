<!doctype html>
<html lang="en">
<head>
<title>{{ record.business }} — Staff Meal customer story</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.headline }}">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header' %}
<main>
<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pt-14 md:px-8 md:pt-20">
    <a href="/customers" class="text-link text-[0.9375rem] font-semibold">Customer stories</a>
    <h1 class="mt-5 max-w-[24ch] text-[clamp(2rem,2.6vw+1rem,3.75rem)]">{{ record.headline }}</h1>
    {%- if record.cover -%}<img src="{{ record.cover }}" class="mt-10 aspect-[16/9] w-full rounded-box object-cover md:aspect-[21/9]">{%- endif -%}
    <dl class="mt-10 grid grid-cols-2 divide-base-300 border-y border-base-300 md:grid-cols-5 md:divide-x">
      <div class="py-4 md:px-5 md:first:pl-0"><dt class="kicker text-base-content/75">The place</dt><dd class="mt-1.5 font-semibold">{{ record.business }}</dd></div>
      <div class="py-4 md:px-5"><dt class="kicker text-base-content/75">Kind</dt><dd class="mt-1.5 font-semibold">{{ record.kind }}</dd></div>
      <div class="py-4 md:px-5"><dt class="kicker text-base-content/75">City</dt><dd class="mt-1.5 font-semibold">{{ record.city }}</dd></div>
      <div class="py-4 md:px-5"><dt class="kicker text-base-content/75">Team</dt><dd class="mt-1.5 font-semibold">{{ record.team }} people, {{ record.locations }} {% if record.locations == 1 %}location{% else %}locations{% endif %}</dd></div>
      <div class="py-4 md:px-5"><dt class="kicker text-base-content/75">On Staff Meal since</dt><dd class="mt-1.5 font-semibold">{{ record.since }}</dd></div>
    </dl>
  </div>

  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-20">
    <div class="grid gap-5 md:grid-cols-2">
      <div class="rounded-box bg-base-200 p-7 md:p-9">
        <p class="kicker text-base-content/75">Before</p>
        <p class="mt-3 text-[1.1875rem] leading-relaxed">{{ record.before }}</p>
      </div>
      <div class="rounded-box bg-secondary p-7 text-secondary-content md:p-9">
        <p class="kicker">Now</p>
        <p class="mt-3 text-[1.1875rem] leading-relaxed">{{ record.now }}</p>
      </div>
    </div>
  </div>

  <div class="mx-auto grid max-w-[84rem] gap-12 px-5 pb-16 md:px-8 lg:grid-cols-12">
    <div class="staff-prose text-[1.0625rem] lg:col-span-7">{{ record.body }}</div>
    <aside class="lg:col-span-4 lg:col-start-9">
      {%- if record.work_photo -%}<img src="{{ record.work_photo }}" class="aspect-[4/5] w-full rounded-box object-cover">{%- endif -%}
    </aside>
  </div>

  <div class="bg-base-200">
    <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-24">
      <blockquote class="max-w-[30ch] font-heading text-[clamp(1.75rem,2vw+1rem,3rem)] leading-tight font-semibold tracking-[-0.02em]">&ldquo;{{ record.quote }}&rdquo;</blockquote>
      <div class="mt-7 flex items-center gap-3.5">
        {% render 'avatar', story: record, box: "size-14", type: "text-base" %}
        <p class="leading-snug"><span class="block font-semibold">{{ record.person }}</span><span class="text-base-content/75">{{ record.role }}, {{ record.business }}</span></p>
      </div>
      {%- if record.figures.size > 0 -%}
      <ul class="mt-12 grid gap-6 border-t border-base-300 pt-8 md:grid-cols-3">
        {%- for figure in record.figures -%}<li class="flex gap-3"><svg class="mt-1 size-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span class="text-[1.1875rem] font-semibold leading-snug">{{ figure }}</span></li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="mx-auto max-w-[84rem] px-5 py-16 md:px-8 md:py-20">
    <div class="flex flex-col gap-6 rounded-box bg-primary px-7 py-10 text-primary-content md:flex-row md:items-center md:justify-between md:px-12">
      <div>
        <h2 class="text-[clamp(1.5rem,1.4vw+1rem,2.25rem)]">Your week, on everyone&rsquo;s phone by Thursday.</h2>
        {% render 'proof', on: "primary", class: "mt-4" %}
      </div>
      <a href="/start#trial" class="btn btn-on-primary btn-lg h-13 px-6">Start your free trial</a>
    </div>
    <h2 class="kicker mt-16 text-base-content/75">Two other stories</h2>
    <ul class="mt-5 grid gap-5 md:grid-cols-2">
      {%- assign shown = 0 -%}
      {%- for story in data.stories -%}{%- if story.id != record.id and shown < 2 -%}{%- assign shown = shown | plus: 1 -%}
      <li><a href="/customers/{{ story.id }}" class="group flex gap-5 rounded-box border border-base-300 p-5 hover:border-primary">
        {%- if story.cover -%}<img src="{{ story.cover }}" class="size-24 shrink-0 rounded-field object-cover">{%- endif -%}
        <span><span class="kicker block text-base-content/75">{{ story.business }}</span><span class="mt-2 block font-semibold leading-snug group-hover:text-primary">{{ story.headline }}</span></span>
      </a></li>
      {%- endif -%}{%- endfor -%}
    </ul>
  </div>
</article>
</main>
{% render 'footer' %}
</body>
</html>
