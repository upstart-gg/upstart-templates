{%- comment -%} The week as a staff time card: pass days (data.hours), and size: 'large' on /visit. A day's lunch or supper left empty says Closed; its note prints under the shift that runs. {%- endcomment -%}
<div data-time-card="{{ size }}">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 bg-primary px-3 py-3 text-primary-content md:px-5">
    <p class="font-heading text-[1.375rem] leading-none uppercase">Time card</p>
    <p class="typed text-base">Halina&rsquo;s</p>
  </div>
  <table>
    <caption class="sr-only">Lunch and supper, day by day</caption>
    <thead>
      <tr class="label-caps">
        <th scope="col">Day</th>
        <th scope="col" class="border-l border-primary">Lunch</th>
        <th scope="col" class="border-l border-primary">Supper</th>
      </tr>
    </thead>
    <tbody>
      {%- for day in days %}
      <tr>
        <th scope="row" class="font-semibold">{{ day.day }}</th>
        {%- if day.lunch == blank and day.supper == blank %}
        <td colspan="2"><span class="closed">Closed</span>{% if day.note != blank %} <span class="text-[0.9375rem]">· {{ day.note }}</span>{% endif %}</td>
        {%- else %}
        <td>{% if day.lunch != blank %}{{ day.lunch }}{% if day.supper == blank and day.note != blank %}<span class="time-note">{{ day.note }}</span>{% endif %}{% else %}<span class="closed">Closed</span>{% endif %}</td>
        <td>{% if day.supper != blank %}{{ day.supper }}{% if day.note != blank %}<span class="time-note">{{ day.note }}</span>{% endif %}{% else %}<span class="closed">Closed</span>{% endif %}</td>
        {%- endif %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
