<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pb-20 md:px-8 md:pb-24">
    <h2 class="section-title">The rooms</h2>
    <div class="mt-10 border-b border-base-300" data-reveal="stagger">
      {%- for room in data["private-plans"] %}
      <div class="grid gap-7 border-t border-base-300 py-9 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-4">
          <h3 class="small-title">{{ room.name }}</h3>
          <p class="typed mt-3 text-[0.9375rem] leading-relaxed">{{ room.seats }}</p>
          <p class="body-copy mt-3">{{ room.description }}</p>
        </div>
        <ul class="space-y-2.5 md:col-span-4">
          {%- for feature in room.features %}
          <li class="flex gap-3"><span class="mt-[0.7em] h-0.5 w-4 shrink-0 bg-primary" aria-hidden="true"></span><span>{{ feature }}</span></li>
          {%- endfor %}
        </ul>
        <div class="md:col-span-4 md:text-right">
          <p class="font-heading text-[2rem] leading-none">{{ room.price }}</p>
          <p class="body-copy mt-3">{{ room.period }}</p>
          <p class="mt-6"><a href="{{ room.href }}" class="btn btn-line whitespace-nowrap">{{ room.cta }}</a></p>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
