<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-28">
    <h2 class="section-title">The counter&rsquo;s year</h2>
    <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {%- for picture in data.gallery %}
      <li>
        {% if picture.image != blank %}<img src="{{ picture.image }}" class="aspect-square w-full rounded-box object-cover" loading="lazy">{% else %}<div class="aspect-square w-full rounded-box bg-secondary"></div>{% endif %}
        <p class="mt-3 font-bold">{{ picture.title }}</p>
        <p class="body-copy text-[0.9375rem]">{{ picture.caption }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
