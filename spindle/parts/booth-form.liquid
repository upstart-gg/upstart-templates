<section id="booth" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-24">
    <div class="grid overflow-hidden rounded-box bg-base-100 lg:grid-cols-12">
      <div class="bg-neutral p-8 text-neutral-content md:p-12 lg:col-span-5">
        <h2 class="section-title">Ask for a booth</h2>
        <p class="mt-5 max-w-[40ch] leading-relaxed">Supper, for up to six. We&rsquo;ll text you to confirm by the afternoon.</p>
        <dl class="typed mt-10 space-y-5 leading-normal">
          <div><dt class="label-caps font-body text-neutral-content/75">Wednesday, Thursday and Saturday</dt><dd class="mt-1.5">Supper, 5&ndash;9:30</dd></div>
          <div><dt class="label-caps font-body text-neutral-content/75">Friday</dt><dd class="mt-1.5">Fish fry, 4:30&ndash;9:30, walk&nbsp;in</dd></div>
          <div><dt class="label-caps font-body text-neutral-content/75">Rather call?</dt><dd class="mt-1.5"><a href="tel:+14145550163" class="link-ink">(414) 555-0163</a></dd></div>
        </dl>
      </div>
      <form hx-post="/_data/bookings" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#booth-form-problems swap:innerHTML" class="grid grid-cols-1 gap-x-5 gap-y-3 p-6 sm:grid-cols-2 md:p-12 lg:col-span-7">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Date</legend>
          <input name="date" type="date" class="input w-full" required>
          <p class="hint">A Wednesday, Thursday or Saturday</p>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Time</legend>
          <select name="time" class="select w-full" required>
            <option value="17:00">5:00 pm</option>
            <option value="17:30">5:30 pm</option>
            <option value="18:00">6:00 pm</option>
            <option value="18:30">6:30 pm</option>
            <option value="19:00" selected>7:00 pm</option>
            <option value="19:30">7:30 pm</option>
            <option value="20:00">8:00 pm</option>
            <option value="20:30">8:30 pm</option>
          </select>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Guests</legend>
          <input name="guests" type="number" class="input w-full" min="1" max="6" value="2" required>
          <p class="hint">Seven or more? <a href="/private#request" class="link-ink">Ask for the back room</a></p>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Where you&rsquo;d like to sit</legend>
          <select name="seating" class="select w-full">
            <option value="booth" selected>A booth</option>
            <option value="counter">The counter</option>
            <option value="either">Either</option>
          </select>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Your name</legend>
          <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Your phone</legend>
          <input name="phone" type="tel" class="input w-full" required maxlength="30" autocomplete="tel">
          <p class="hint">We confirm by text</p>
        </fieldset>
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend">Your email</legend>
          <input name="email" type="email" class="input w-full" maxlength="200" autocomplete="email">
        </fieldset>
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend">Anything we should know?</legend>
          <textarea name="message" class="textarea w-full" rows="4" maxlength="2000" placeholder="Allergies, a birthday, a high chair"></textarea>
        </fieldset>
        <div id="booth-form-problems" class="sm:col-span-2"></div>
        <div class="mt-2 sm:col-span-2">
          <button type="submit" class="btn btn-primary btn-lg">Ask for a booth</button>
          <p class="hint mt-4">We&rsquo;ll text you to confirm by the afternoon. Nothing is held until we do.</p>
        </div>
      </form>
    </div>
  </div>
</section>
