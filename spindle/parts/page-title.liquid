{%- comment -%} A page's title: pass title and intro, and image (an address in /media) for a photo beside them. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 pt-14 pb-14 md:px-8 md:pt-20 md:pb-20 lg:grid-cols-12 lg:items-end">
    <div class="{% if image %}lg:col-span-7{% else %}lg:col-span-9{% endif %}">
      <h1 class="page-title">{{ title }}</h1>
      <p class="body-copy mt-7 max-w-[54ch] text-[1.1875rem]">{{ intro }}</p>
    </div>
    {%- if image %}
    <div class="lg:col-span-5"><img src="{{ image }}" class="aspect-[4/3] w-full rounded-box object-cover"></div>
    {%- endif %}
  </div>
</section>
