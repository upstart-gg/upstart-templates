<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p class="label-caps text-base-content/75">The week</p>
      <h2 class="section-title mt-3">Two services, six days</h2>
      <ul class="mt-9 border-b border-base-300">
        {%- for service in data["home-services"] %}
        <li class="border-t border-base-300 py-5 text-[1.125rem] leading-normal">{{ service.line }}</li>
        {%- endfor %}
      </ul>
      <p class="mt-8"><a href="/visit" class="link-ink font-bold">Hours and finding us</a></p>
    </div>
    <div class="lg:col-span-6 lg:col-start-7">{% render 'time-card', days: data.hours, size: 'small' %}</div>
  </div>
</section>
