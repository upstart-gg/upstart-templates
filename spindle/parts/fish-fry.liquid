<section id="fish-fry" class="bg-primary text-primary-content">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-6"><img src="/media/perch-fry.webp" class="w-full" data-cutout loading="lazy"></div>
    <div class="lg:col-span-6">
      <h2 class="section-title">Friday fish fry&nbsp;·<br>4:30 to 9:30</h2>
      <ul class="mt-9 border-b border-primary-content/40">
        {%- for plate in data["fish-fry"] %}
        <li class="border-t border-primary-content/40 py-4">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-body text-[1.1875rem] font-bold">{{ plate.name }}</h3>
            <p class="typed whitespace-nowrap">{{ plate.price }}</p>
          </div>
          <p class="mt-1 text-[0.9375rem] italic">{{ plate.description }}</p>
        </li>
        {%- endfor %}
      </ul>
      <p class="mt-7 max-w-[52ch] leading-relaxed">No reservations on Fridays. Give your name at the counter; we&rsquo;ll text you when your booth is ready.</p>
    </div>
  </div>
</section>
