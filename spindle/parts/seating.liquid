<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 pb-20 md:px-8 md:pb-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="section-title">How seating works</h2>
    </div>
    <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8" data-reveal="stagger">
      {%- for note in data["reserve-features"] %}
      <li class="border-t-2 border-base-content pt-5">
        <h3 class="small-title">{{ note.title }}</h3>
        <p class="body-copy mt-2.5">{{ note.text }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
