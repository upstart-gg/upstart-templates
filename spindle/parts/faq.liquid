{%- comment -%} Questions as ruled details: pass items, title, and columns: true for two columns. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="section-title">{{ title }}</h2>
      <p class="body-copy mt-5 max-w-[34ch]">Anything else, call us at <a href="tel:+14145550163" class="link-ink whitespace-nowrap">(414) 555-0163</a>.</p>
    </div>
    <div class="lg:col-span-8 {% if columns %}grid items-start gap-x-10 md:grid-cols-2{% endif %}">
      {%- for item in items %}
      <details class="question border-b border-base-300 {% if forloop.first %}border-t{% elsif columns and forloop.index == 2 %}md:border-t{% endif %}">
        <summary class="flex items-start justify-between gap-6 py-5 text-[1.125rem] leading-snug font-bold">{{ item.question }}<span class="question-mark text-[1.5rem] leading-none font-normal" aria-hidden="true">+</span></summary>
        <div class="body-copy answer max-w-[60ch] pb-6">{{ item.answer }}</div>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>
