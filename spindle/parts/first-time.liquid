<section class="bg-primary text-primary-content">
  <div class="mx-auto max-w-[90rem] px-5 pt-20 pb-20 md:px-8 md:pt-24 md:pb-24">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-5">
      <div>
        <p class="label-caps">Order these first</p>
        <h2 class="section-title mt-3">If it&rsquo;s your first time</h2>
      </div>
      <a href="/menu" class="btn btn-line btn-lg whitespace-nowrap">See both menus</a>
    </div>
    <ul class="mt-14 grid gap-x-10 gap-y-14 md:grid-cols-3">
      {%- for dish in data.menu %}{% if dish.featured %}
      <li class="grid grid-rows-subgrid row-span-2 gap-y-0">
        <div class="flex items-end">{% if dish.image != blank %}<img src="{{ dish.image }}" class="w-full" data-cutout>{% endif %}</div>
        <div>
          <div class="mt-7 flex items-baseline justify-between gap-4">
            <h3 class="font-body text-[1.25rem] font-bold">{{ dish.name }}</h3>
            <p class="typed whitespace-nowrap">{{ dish.price }}</p>
          </div>
          <p class="mt-2 max-w-[38ch] leading-relaxed">{{ dish.description }}</p>
        </div>
      </li>
      {% endif %}{%- endfor %}
    </ul>
  </div>
</section>
