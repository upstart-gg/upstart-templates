<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pt-14 pb-16 md:px-8 md:pt-20 md:pb-20">
    <h1 class="page-title">Our hours</h1>
    <div class="mt-10 md:mt-12">{% render 'time-card', days: data.hours, size: 'large' %}</div>
    <div class="body-copy mt-8 grid gap-x-10 gap-y-3 md:grid-cols-2">
      <p>The kitchen takes its last order half an hour before close.</p>
