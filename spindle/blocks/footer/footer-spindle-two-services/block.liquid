<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-[90rem] px-5 pt-20 pb-10 md:px-8 md:pt-24">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <p class="section-title font-heading">Halina&rsquo;s</p>
        <p class="mt-5 max-w-[32ch] text-neutral-content/80">Lunch and supper under the same sign since 1961.</p>
        <p class="mt-6"><a href="/reserve#booth" class="btn btn-primary whitespace-nowrap">Reserve a booth</a></p>
      </div>
      <div class="lg:col-span-3">
        <p class="label-caps text-neutral-content/70">Find us</p>
        <address class="mt-4 leading-relaxed not-italic">14 Tamarack Court, at Lincoln Avenue<br>Milwaukee, WI&nbsp;53215</address>
        <p class="mt-3"><a href="https://www.openstreetmap.org/search?query=14%20Tamarack%20Court%2C%20Milwaukee%2C%20WI%2053215" class="link-ink" rel="noopener" target="_blank">Get directions</a></p>
        <p class="mt-3"><a href="tel:+14145550163" class="link-ink whitespace-nowrap">(414) 555-0163</a></p>
        <p class="mt-2"><a href="mailto:hello@halinaslunch.com" class="link-ink">hello@halinaslunch.com</a></p>
      </div>
      <div class="lg:col-span-3">
        <p class="label-caps text-neutral-content/70">Two services</p>
        <div class="typed mt-4 space-y-3 text-[0.9375rem] leading-relaxed">
          <p>Lunch · Tue&ndash;Sun<br>11&ndash;2:30 (Sun 10&ndash;2)</p>
          <p>Supper · Wed&ndash;Sat<br>5&ndash;9:30 (Fri from 4:30)</p>
          <p>Closed Mondays</p>
        </div>
        <p class="mt-5">Gift cards at the counter</p>
      </div>
      <div class="lg:col-span-2">
        <p class="label-caps text-neutral-content/70">Halina&rsquo;s</p>
        <nav aria-label="Footer" class="mt-4">
          <ul class="space-y-2">
            {%- for item in data.navigation %}{% if item.place != "social" %}
            <li><a href="{{ item.href }}" class="link-ink">{{ item.label }}</a></li>
            {%- endif %}{% endfor %}
            {%- for item in data.navigation %}{% if item.place == "social" %}
            <li><a href="{{ item.href }}" class="link-ink" rel="noopener" target="_blank">{{ item.label }}</a></li>
            {%- endif %}{% endfor %}
          </ul>
        </nav>
      </div>
    </div>
    <p class="mt-16 border-t border-neutral-content/20 pt-6 text-[0.9375rem] text-neutral-content/70">Halina&rsquo;s · 14 Tamarack Court, Milwaukee · Written up at ten, till it&rsquo;s gone</p>
  </div>
</footer>
