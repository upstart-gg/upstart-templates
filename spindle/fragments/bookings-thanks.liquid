{%- assign first = record.name | split: " " | first -%}
{%- capture count -%}{%- case record.guests -%}{%- when 1 -%}one{%- when 2 -%}two{%- when 3 -%}three{%- when 4 -%}four{%- when 5 -%}five{%- when 6 -%}six{%- else -%}{{ record.guests }}{%- endcase -%}{%- endcapture -%}
{%- capture time -%}{%- case record.time -%}{%- when "17:00" -%}5{%- when "17:30" -%}5:30{%- when "18:00" -%}6{%- when "18:30" -%}6:30{%- when "19:00" -%}7{%- when "19:30" -%}7:30{%- when "20:00" -%}8{%- when "20:30" -%}8:30{%- else -%}{{ record.time }}{%- endcase -%}{%- endcapture -%}
<div class="p-8 md:p-12 lg:col-span-7" role="status">
  <p class="small-title">Thank you, {{ first }}.</p>
  <p class="mt-4 max-w-[46ch] text-[1.125rem] leading-relaxed">We&rsquo;ve got your request for {% if record.seating == "counter" %}seats at the counter{% elsif record.seating == "either" %}a booth or the counter{% else %}a booth{% endif %} for {{ count }} on {{ record.date | date: "%A" }} at {{ time }}, and we&rsquo;ll text you by the afternoon to confirm.</p>
</div>
