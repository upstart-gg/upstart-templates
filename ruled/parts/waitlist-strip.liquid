{%- comment -%} The compact waitlist field: pass id (its own on the page). {%- endcomment -%}
{%- assign next = data.cohorts | where: "status", "waitlist" | first -%}
<div class="w-full max-w-[28rem]">
<form hx-post="/_data/waitlist" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#{{ id }}-problems swap:innerHTML">
  {% if next %}<input type="hidden" name="cohorts" value="{{ next.name }}">{% endif %}
  <label class="font-bold" for="{{ id }}-email">{% if next %}Hear when {{ next.name }} opens{% else %}Hear when the next cohort opens{% endif %}</label>
  <div class="mt-2 flex flex-col gap-3 sm:flex-row">
    <input id="{{ id }}-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input w-full">
    <button class="btn btn-outline">Join the waitlist</button>
  </div>
  <div id="{{ id }}-problems" class="mt-2"></div>
  <p class="small mt-2 text-base-content/70">One email when enrollment opens. Nothing else.</p>
</form>
</div>
