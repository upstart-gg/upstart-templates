<section id="questions" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="grid gap-10 border-t border-base-content pt-6 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="title-section">Questions</h2>
        <p class="body-copy mt-4">Still unsure? Write to Hollis.</p>
        <p class="mt-1"><a href="mailto:hollis@theslowdraft.com" class="link-mark break-words">hollis@theslowdraft.com</a></p>
      </div>
      <div class="ruled ruled-beside lg:col-span-7 lg:col-start-6">
        {% for item in data.enroll-faq %}
        <div>{% render 'question', item: item %}</div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
