<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="grid gap-10 border-t border-base-content pt-6 lg:grid-cols-12">
      <h2 class="title-section lg:col-span-4">Questions</h2>
      <ol class="ruled ruled-beside lg:col-span-7 lg:col-start-6">
        {% for item in data.home-faq %}
        <li>{% render 'question', item: item, number: forloop.index %}</li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
