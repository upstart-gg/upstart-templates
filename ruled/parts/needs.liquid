<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="grid items-center gap-10 border-t border-base-content pt-10 lg:grid-cols-12 lg:gap-12">
      <img src="/media/notebook.jpg" class="aspect-[3/2] w-full rounded-box object-cover lg:col-span-5">
      <div class="lg:col-span-7">
        <h2 class="title-section">What you&rsquo;ll need</h2>
        <ul class="ruled mt-8">
          {% for item in data.syllabus-needs %}
          <li class="py-4 text-[1.1875rem]">{{ item.text }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
