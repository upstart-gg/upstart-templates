<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="border-t border-base-content pt-6">
      <h2 class="title-section">What a week asks</h2>
      <dl class="mt-10 grid border-y border-base-300 sm:grid-cols-2 lg:grid-cols-4">
        {% for figure in data.syllabus-figures %}
        <div class="border-base-300 py-8 max-sm:not-first:border-t sm:max-lg:px-6 sm:max-lg:odd:border-r sm:max-lg:odd:pl-0 sm:max-lg:nth-[n+3]:border-t lg:px-8 lg:not-first:border-l lg:first:pl-0">
          <dt class="flex items-baseline gap-3"><span class="serif figures text-[3rem] leading-none">{{ figure.value }}</span> <span class="title-small">{{ figure.label }}</span></dt>
          {% if figure.note %}<dd class="small mt-3 text-base-content/80">{{ figure.note }}</dd>{% endif %}
        </div>
        {% endfor %}
      </dl>
    </div>
  </div>
</section>
