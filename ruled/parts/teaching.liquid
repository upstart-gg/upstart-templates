<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="grid gap-10 border-t border-base-content pt-6 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="pencil-label">How she teaches</p>
        <h2 class="title-section mt-2">Slow is <span class="mark">a method</span></h2>
      </div>
      <ol class="ruled ruled-beside lg:col-span-7 lg:col-start-6">
        {% for item in data.about-teaching %}
        <li class="grid grid-cols-[3.5rem_1fr] items-baseline gap-x-4 py-6 md:grid-cols-[5rem_1fr]">
          <span class="numeral" aria-hidden="true">{{ forloop.index }}</span>
          <div>
            <h3 class="title-small">{{ item.title }}</h3>
            {% if item.text %}<p class="body-copy mt-1">{{ item.text }}</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
