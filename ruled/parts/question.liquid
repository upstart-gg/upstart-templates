{%- comment -%} One question, opened without movement: pass item, and number to have it numbered. {%- endcomment -%}
<details class="question">
  <summary class="flex items-baseline gap-4 py-5 md:gap-6">
    {% if number %}<span class="figures w-7 shrink-0 text-[1.375rem] leading-[1.3] text-accent md:w-10" aria-hidden="true">{{ number }}</span>{% endif %}
    <span class="title-small flex-1 font-medium"><span class="ask">{{ item.question }}</span></span>
    <span class="serif text-[1.5rem] leading-none" aria-hidden="true"><span class="shut">+</span><span class="open">&minus;</span></span>
  </summary>
  <div class="marked-links body-copy measure space-y-3 pb-7{% if number %} pl-11 md:pl-16{% endif %}">{{ item.answer }}</div>
</details>
