{%- comment -%} The linked syllabus: the weeks beside their calendar, each lit from the other (data-syllabus, data-week; styles/site.css). {%- endcomment -%}
<section id="weeks" data-syllabus class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="border-t border-base-content pt-6">
      <p class="pencil-label">Syllabus</p>
      <h2 class="title-section mt-2">Six weeks, twelve evenings</h2>
      <p class="body-copy measure mt-4">Each week meets on a Tuesday and a Thursday, 7 to 8:30 pm Eastern.</p>
    </div>
    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-10 xl:grid-cols-12">
      <div class="xl:col-span-7">
        <ol class="ruled">
          {% for week in data.weeks %}
          <li id="week-{{ week.number }}" data-week="{{ week.number }}" class="grid grid-cols-[3rem_1fr] gap-x-4 py-5 md:grid-cols-[4rem_1fr]">
            <span class="numeral week-number pt-1 text-right" aria-hidden="true">{{ week.number }}</span>
            <div class="week-body py-1 pl-5 md:pl-6">
              <h3 class="title-small"><a href="/syllabus#week-{{ week.number }}"><span class="sr-only">Week {{ week.number }}: </span><span class="week-name">{{ week.title }}</span></a></h3>
              {% if week.line %}<p class="body-copy mt-1.5">{{ week.line }}</p>{% endif %}
              <p class="small mt-2 text-accent">{% render 'week-dates', week: week %}</p>
            </div>
          </li>
          {% endfor %}
        </ol>
        <p class="mt-8"><a href="/syllabus" class="link-mark font-semibold">Read the whole syllabus</a></p>
      </div>
      <div class="hidden md:block md:max-lg:order-first xl:col-span-5">
        {% render 'cohort-calendar', weeks: data.weeks %}
      </div>
    </div>
  </div>
</section>
