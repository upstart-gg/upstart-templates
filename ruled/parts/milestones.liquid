<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="border-t border-base-content pt-6">
      <h2 class="title-section">The course so far</h2>
      <ol class="mt-10 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
        {% for milestone in data.about-milestones %}
        <li class="border-t border-base-300 pt-5 pb-10">
          {% if milestone.year %}<p class="figures text-[2rem] leading-none text-accent">{{ milestone.year }}</p>{% endif %}
          <h3 class="title-small mt-3">{{ milestone.title }}</h3>
          {% if milestone.text %}<p class="body-copy mt-1">{{ milestone.text }}</p>{% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
