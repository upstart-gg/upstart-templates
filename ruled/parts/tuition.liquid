{%- assign cohort = data.cohorts | where: "status", "enrolling" | first -%}
{%- unless cohort %}{% assign cohort = data.cohorts | first %}{% endunless -%}
<section id="tuition" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="grid overflow-hidden rounded-box border border-base-content lg:grid-cols-3">
      <div class="p-6 md:p-12 lg:col-span-2">
        <h2 class="title-section">Everything in the six weeks</h2>
        <ul class="ruled-grid mt-8 grid gap-x-10 sm:grid-cols-2">
          {% for item in data.home-included %}
          <li class="border-t border-base-300 py-4">{{ item.text }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="flex flex-col justify-center border-t border-base-content bg-base-200 p-6 md:p-12 lg:border-t-0 lg:border-l">
        {% if cohort.tuition %}<p class="figures text-[3rem] leading-none font-medium">${{ cohort.tuition }}</p>{% endif %}
        {% if cohort.plan %}<p class="mt-2">{{ cohort.plan }}</p>{% endif %}
        <p class="body-copy mt-6">Four places in every cohort are pay-what-you-can, from $200, <span class="mark text-base-content">no reasons asked</span>.</p>
        <a href="/enroll#ask" class="btn btn-primary mt-8 self-start">Ask for a place</a>
      </div>
    </div>
  </div>
</section>
