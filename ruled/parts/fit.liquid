<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <h2 class="sr-only">Who it&rsquo;s for</h2>
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h3 class="title-section border-t border-base-content pt-6 font-medium">It&rsquo;s for you if</h3>
        <ul class="ruled mt-8">
          {% for item in data.home-fit %}{% if item.side == "for" %}
          <li class="py-5 text-[1.1875rem] leading-relaxed">{{ item.text }}</li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      <div>
        <h3 class="title-section border-t border-base-content pt-6 font-medium">It may not be for you if</h3>
        <ul class="ruled mt-8">
          {% for item in data.home-fit %}{% if item.side == "not" %}
          <li class="py-5 text-[1.1875rem] leading-relaxed">{{ item.text }}</li>
          {% endif %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
