<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-24 md:px-8 md:pb-36">
    <div class="grid gap-10 border-t border-base-content pt-6 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="title-section">Between sessions</h2>
        <p class="body-copy mt-4 max-w-[38ch]">Most of an essay happens on a Sunday, with nobody looking. Here is what keeps you company.</p>
      </div>
      <ul class="ruled ruled-beside lg:col-span-7 lg:col-start-6">
        {% for item in data.syllabus-between %}
        <li class="py-6">
          <h3 class="title-small">{{ item.title }}</h3>
          {% if item.text %}<p class="body-copy mt-1">{{ item.text }}</p>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
